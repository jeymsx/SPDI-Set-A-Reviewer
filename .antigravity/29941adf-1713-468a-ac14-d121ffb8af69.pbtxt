        }
        lines {
          text: "    // Map logic mapping virtual indices (what user is viewing) to real data indices"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    function buildIndicesMap() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const size = questions.length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      let indices = Array.from({length: size}, (_, i) => i);"
