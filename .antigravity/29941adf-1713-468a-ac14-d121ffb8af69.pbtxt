    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    // State management variables\n    let questions = []; // Stores the master list of questions\n    let userAnswers = {}; // key: question ID, value: selected choice\n    let currentIdx = 0; // index of active question\n    let isGraded = false; // flag indicating if test is scored\n    let reviewIncorrectOnly = false; // toggle study mode\n    let shuffledQuestionsPool = null; // optional randomized indexing array\n    let shuffledChoicesPool = {}; // key: question ID, value: randomized choice indices\n    let originalIndicesMap = []; // Maps current index to original indices\n\n    // Settings\n    let shuffleQuestionsEnabled = false;\n    let shuffleChoicesEnabled = false;\n\n    // Local Storage keys\n    const LS_KEY_ANSWERS = \"spdi_user_answers\";\n    const LS_KEY_IDX = \"spdi_current_idx\";\n    const LS_KEY_GRADED = \"spdi_is_graded\";\n    const LS_KEY_WELCOME = \"spdi_welcome_dismissed\";\n    const LS_KEY_SHUFFLE_Q = \"spdi_shuffle_questions\";\n    const LS_KEY_SHUFFLE_C = \"spdi_shuffle_choices\";\n    const LS_KEY_THEME = \"spdi_theme_dark\";\n\n    // Initialize the whole test\n    function init() {\n      // Get correct dataset\n      if (window.questionsData && Array.isArray(window.questionsData)) {\n        questions = window.questionsData;\n      } else {\n        console.error(\"questionsData not found or corrupted.\");\n        return;\n      }\n\n      // Check Saved Theme\n      const isDark = localStorage.getItem(LS_KEY_THEME) === \"true\";\n      if (isDark) {\n        document.documentElement.classList.add(\'dark\');\n        document.documentElement.classList.remove(\'light\');\n      } else {\n        document.documentElement.classList.remove(\'dark\');\n        document.documentElement.classList.add(\'light\');\n      }\n\n      // Read saved welcomes\n      if (localStorage.getItem(LS_KEY_WELCOME) === \"true\") {\n        document.getElementById(\'welcome-card\').classList.add(\'hidden\');\n      }\n\n      // Read saved configurations\n      shuffleQuestionsEnabled = localStorage.getItem(LS_KEY_SHUFFLE_Q) === \"true\";\n      shuffleChoicesEnabled = localStorage.getItem(LS_KEY_SHUFFLE_C) === \"true\";\n\n      document.getElementById(\'shuffle-questions-toggle\').checked = shuffleQuestionsEnabled;\n      document.getElementById(\'shuffle-choices-toggle\').checked = shuffleChoicesEnabled;\n\n      // Restore userAnswers\n      const savedAnswers = localStorage.getItem(LS_KEY_ANSWERS);\n      if (savedAnswers) {\n        try {\n          userAnswers = JSON.parse(savedAnswers);\n        } catch(e) {\n          userAnswers = {};\n        }\n      }\n\n      // Restore graded status\n      isGraded = localStorage.getItem(LS_KEY_GRADED) === \"true\";\n\n      // Setup list structures\n      buildIndicesMap();\n\n      // Restore current index\n      const savedIdx = localStorage.getItem(LS_KEY_IDX);\n      if (savedIdx !== null) {\n        const parsed = parseInt(savedIdx);\n        if (!isNaN(parsed) && parsed >= 0 && parsed < originalIndicesMap.length) {\n          currentIdx = parsed;\n        }\n      }\n\n      // Render Everything\n      renderProgress();\n      renderActiveQuestion();\n      renderNavigator();\n\n      // Post-Submit Setup\n      if (isGraded) {\n        revealGradedStates();\n      }\n\n      // Lucide icons render\n      lucide.createIcons();\n    }"
      replacement_content: "    // State management variables\n    let questions = []; // Stores the master list of questions\n    let userAnswers = {}; // key: question ID, value: selected choice\n    let currentIdx = 0; // index of active question\n    let isGraded = false; // flag indicating if test is scored\n    let reviewIncorrectOnly = false; // toggle study mode\n    let shuffledQuestionsPool = null; // optional randomized indexing array\n    let shuffledChoicesPool = {}; // key: question ID, value: randomized choice indices\n    let originalIndicesMap = []; // Maps current index to original indices\n\n    // Exam & Timer state variables\n    let examStarted = false;\n    let timerDuration = 90; // Default 90 minutes\n    let timerEndTime = 0; // Timestamp when it ends\n    let timerInterval = null;\n\n    // Settings\n    let shuffleQuestionsEnabled = false;\n    let shuffleChoicesEnabled = false;\n\n    // Local Storage keys\n    const LS_KEY_ANSWERS = \"spdi_user_answers\";\n    const LS_KEY_IDX = \"spdi_current_idx\";\n    const LS_KEY_GRADED = \"spdi_is_graded\";\n    const LS_KEY_WELCOME = \"spdi_welcome_dismissed\";\n    const LS_KEY_SHUFFLE_Q = \"spdi_shuffle_questions\";\n    const LS_KEY_SHUFFLE_C = \"spdi_shuffle_choices\";\n    const LS_KEY_THEME = \"spdi_theme_dark\";\n    const LS_KEY_EXAM_STARTED = \"spdi_exam_started\";\n    const LS_KEY_TIMER_DURATION = \"spdi_timer_duration\";\n    const LS_KEY_TIMER_END_TIME = \"spdi_timer_end_time\";\n\n    // Initialize the whole test\n    function init() {\n      // Get correct dataset\n      if (window.questionsData && Array.isArray(window.questionsData)) {\n        questions = window.questionsData;\n      } else {\n        console.error(\"questionsData not found or corrupted.\");\n        return;\n      }\n\n      // Update total questions on start screen dynamically\n      document.getElementById(\'start-total-questions\').innerText = `${questions.length} Questions`;\n\n      // Check Saved Theme\n      const isDark = localStorage.getItem(LS_KEY_THEME) === \"true\";\n      if (isDark) {\n        document.documentElement.classList.add(\'dark\');\n        document.documentElement.classList.remove(\'light\');\n      } else {\n        document.documentElement.classList.remove(\'dark\');\n        document.documentElement.classList.add(\'light\');\n      }\n\n      // Read saved welcomes\n      if (localStorage.getItem(LS_KEY_WELCOME) === \"true\") {\n        document.getElementById(\'welcome-card\').classList.add(\'hidden\');\n      }\n\n      // Read saved configurations\n      shuffleQuestionsEnabled = localStorage.getItem(LS_KEY_SHUFFLE_Q) === \"true\";\n      shuffleChoicesEnabled = localStorage.getItem(LS_KEY_SHUFFLE_C) === \"true\";\n\n      document.getElementById(\'shuffle-questions-toggle\').checked = shuffleQuestionsEnabled;\n      document.getElementById(\'shuffle-choices-toggle\').checked = shuffleChoicesEnabled;\n\n      // Restore userAnswers\n      const savedAnswers = localStorage.getItem(LS_KEY_ANSWERS);\n      if (savedAnswers) {\n        try {\n          userAnswers = JSON.parse(savedAnswers);\n        } catch(e) {\n          userAnswers = {};\n        }\n      }\n\n      // Restore graded status\n      isGraded = localStorage.getItem(LS_KEY_GRADED) === \"true\";\n\n      // Setup list structures\n      buildIndicesMap();\n\n      // Restore current index\n      const savedIdx = localStorage.getItem(LS_KEY_IDX);\n      if (savedIdx !== null) {\n        const parsed = parseInt(savedIdx);\n        if (!isNaN(parsed) && parsed >= 0 && parsed < originalIndicesMap.length) {\n          currentIdx = parsed;\n        }\n      }\n\n      // Restore Exam session state\n      examStarted = localStorage.getItem(LS_KEY_EXAM_STARTED) === \"true\";\n      const savedDuration = localStorage.getItem(LS_KEY_TIMER_DURATION);\n      if (savedDuration !== null) {\n        timerDuration = parseInt(savedDuration);\n        document.getElementById(\'start-duration-select\').value = timerDuration.toString();\n      }\n      const savedEndTime = localStorage.getItem(LS_KEY_TIMER_END_TIME);\n      if (savedEndTime !== null) {\n        timerEndTime = parseInt(savedEndTime);\n      }\n\n      // If already graded, bypass start screen directly\n      if (isGraded) {\n        examStarted = true;\n      }\n\n      // Toggle views depending on whether the exam is active\n      if (examStarted) {\n        document.getElementById(\'start-screen\').classList.add(\'hidden\');\n        document.getElementById(\'exam-workspace\').classList.remove(\'hidden\');\n        \n        if (isGraded) {\n          showTimerCompletedState();\n        } else if (timerDuration > 0) {\n          startTimerTicker();\n        } else {\n          hideTimerUI();\n        }\n      } else {\n        document.getElementById(\'start-screen\').classList.remove(\'hidden\');\n        document.getElementById(\'exam-workspace\').classList.add(\'hidden\');\n        hideTimerUI();\n      }\n\n      // Set up start screen actions\n      document.getElementById(\'start-exam-btn\').onclick = () => {\n        const durationSelect = document.getElementById(\'start-duration-select\');\n        const minutes = parseInt(durationSelect.value);\n        startExam(minutes);\n      };\n\n      document.getElementById(\'start-clear-btn\').onclick = () => {\n        clearAllProgress();\n      };\n\n      // Render Everything\n      renderProgress();\n      renderActiveQuestion();\n      renderNavigator();\n\n      // Post-Submit Setup\n      if (isGraded) {\n        revealGradedStates();\n      }\n\n      // Lucide icons render\n      lucide.createIcons();\n    }"
    }
