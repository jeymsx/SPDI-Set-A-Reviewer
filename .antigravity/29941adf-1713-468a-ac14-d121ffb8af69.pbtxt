        replacement_content: "  <!-- OVERLAY SCORE BOARD (Shown after Submission) -->\n  <div id=\"results-modal\" class=\"hidden fixed inset-0 bg-[#0f172a]/60 dark:bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n    <div class=\"bg-white dark:bg-[#1e293b] rounded-xl max-w-lg w-full p-6 sm:p-8 border border-[#e2e8f0] dark:border-[#334155] shadow-2xl relative space-y-6 overflow-hidden\">\n      <div class=\"absolute right-0 top-0 w-32 h-32 bg-[#2563eb]/10 rounded-full blur-2xl\"></div>\n      \n      <div class=\"text-center space-y-2\">\n        <div class=\"inline-flex p-3 bg-[#eff6ff] dark:bg-[#2563eb]/20 rounded-full text-[#2563eb] dark:text-[#3b82f6] mb-1\">\n          <i data-lucide=\"check-square\" class=\"w-10 h-10\"></i>\n        </div>\n        <h2 class=\"text-2xl font-black text-[#1e293b] dark:text-white tracking-tight\">Master\'s Mastery Test Results</h2>\n        <p class=\"text-xs text-[#64748b] dark:text-[#94a3b8] uppercase tracking-widest font-extrabold\">Final Performance Summary</p>\n      </div>\n\n      <!-- Dynamic Score Circular Display -->\n      <div class=\"flex flex-col items-center justify-center space-y-2 py-4\">\n        <div class=\"relative w-36 h-36 flex items-center justify-center\">\n          <!-- Circular ring fallback -->\n          <svg class=\"absolute inset-0 w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\">\n            <circle class=\"text-[#e2e8f0] dark:text-[#334155]\" stroke-width=\"8\" stroke=\"currentColor\" fill=\"transparent\" r=\"40\" cx=\"50\" cy=\"50\"/>\n            <circle id=\"circle-progress\" class=\"text-[#2563eb]\" stroke-width=\"8\" stroke-dasharray=\"251.2\" stroke-dashoffset=\"251.2\" stroke-linecap=\"round\" stroke=\"currentColor\" fill=\"transparent\" r=\"40\" cx=\"50\" cy=\"50\"/>\n          </svg>\n          <div class=\"text-center\">\n            <span id=\"results-percentage\" class=\"text-3xl font-black block text-[#1e293b] dark:text-white\">0%</span>\n  