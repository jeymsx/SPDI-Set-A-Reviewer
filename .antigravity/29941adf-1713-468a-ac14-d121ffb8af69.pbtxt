      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFxiWVkT1XBORXLoF-zjOgerrAgGbOQ6pm39FpMK8zSk4Nc_LUle92ofg1x0s5lPQhJQxWF7Y56OWwaWXMO6zbbwMBj200zcEMVDpZ-85G8Ul3O6xHXVxA_LZScyO51MkykZPt6In6g4Eg0i1YKBw=="
