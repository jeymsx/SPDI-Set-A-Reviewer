    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQH_63zErx8IvkNIX4jB0ALzVGldwSSp9b61RUt32icNveUSS9sVD--Xbga3M0NRhMQof8IWXoSVbe8WjhJMeFyqQmmzdhjFUNx78uZf-rAlykBcadZ5irM1kckNaofX29qGyfOnSp-zYHiq7Q=="
