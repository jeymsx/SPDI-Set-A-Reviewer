        replacement_content: "  {\n    id: 25,\n    question: \"Which of the following is a bushing?\",\n    choices: [\"A\", \"B\", \"C\", \"D\"],\n    correctAnswer: \"B\",\n    svgs: [\n      `<svg width=\"80\" height=\"80\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"text-slate-600 dark:text-slate-300\">\n        <!-- Union nut in the middle -->\n        <rect x=\"25\" y=\"38\" width=\"50\" height=\"24\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" />\n        <line x1=\"35\" y1=\"38\" x2=\"35\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"45\" y1=\"38\" x2=\"45\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"55\" y1=\"38\" x2=\"55\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"65\" y1=\"38\" x2=\"65\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Left pipe section -->\n        <path d=\"M5 44 H25 V56 H5 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Right pipe section -->\n        <path d=\"M75 44 H95 V56 H75 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Fitting collar connections -->\n        <rect x=\"15\" y=\"41\" width=\"10\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <rect x=\"75\" y=\"41\" width=\"10\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n      </svg>`,\n      `<svg width=\"80\" height=\"80\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"text-slate-600 dark:text-slate-300\">\n        <!-- Hex nut head -->\n        <polygon points=\"15,25 45,15 75,25 75,75 45,85 15,75\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Inside female threaded core -->\n        <circle cx=\"45\" cy=\"50\" r=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-dasharray=\"3,2\" />\n        <!-- Outside male threads on the right shank -->\n        <path d=\"M75 35 H90\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M75 42 H92\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M75 49 H94\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M75 56 H94\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M75 63 H92\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M75 70 H90\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Outer sleeve thread connection -->\n        <rect x=\"75\" y=\"32\" width=\"5\" height=\"36\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n      </svg>`,\n      `<svg width=\"80\" height=\"80\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"text-slate-600 dark:text-slate-300\">\n        <!-- Left threads -->\n        <path d=\"M5 38 H25 V62 H5 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"10\" y1=\"38\" x2=\"10\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"15\" y1=\"38\" x2=\"15\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"20\" y1=\"38\" x2=\"20\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Center hexagonal unthreaded portion -->\n        <polygon points=\"25,35 50,30 75,35 75,65 50,70 25,65\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Right threads -->\n        <path d=\"M75 38 H95 V62 H75 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"80\" y1=\"38\" x2=\"80\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"85\" y1=\"38\" x2=\"85\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <line x1=\"90\" y1=\"38\" x2=\"90\" y2=\"62\" stroke=\"currentColor\" stroke-width=\"2\" />\n      </svg>`,\n      `<svg width=\"80\" height=\"80\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"text-slate-600 dark:text-slate-300\">\n        <!-- Straight sleeve block -->\n        <rect x=\"15\" y=\"30\" width=\"70\" height=\"40\" rx=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Internal thread dash lines indicating female thread on both sides -->\n        <path d=\"M22 35 L22 65\" stroke-dasharray=\"3,2\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M28 35 L28 65\" stroke-dasharray=\"3,2\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M72 35 L72 65\" stroke-dasharray=\"3,2\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <path d=\"M78 35 L78 65\" stroke-dasharray=\"3,2\" stroke=\"currentColor\" stroke-width=\"2\" />\n        <!-- Center division line -->\n        <line x1=\"50\" y1=\"30\" x2=\"50\" y2=\"70\" stroke-width=\"1.5\" stroke-dasharray=\"4,4\" stroke=\"currentColor\" />\n      </svg>`\n    ]\n  },"
