      target_content: "  {\n    id: 59,\n    question: \"Identify the part of the valve:\",\n    choices: [\"Packing Gland\", \"Packing Nut\", \"Packing\", \"O-ring\"],\n    correctAnswer: \"Packing\",\n    questionSvg: `<svg width=\"220\" height=\"180\" viewBox=\"0 0 220 180\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" class=\"text-slate-700 dark:text-slate-300 mx-auto\">\n      <!-- Handwheel -->\n      <ellipse cx=\"110\" cy=\"20\" rx=\"45\" ry=\"10\" fill=\"none\" stroke=\"currentColor\" />\n      <line x1=\"110\" y1=\"20\" x2=\"110\" y2=\"35\" stroke-width=\"3\" stroke=\"currentColor\" />\n      <!-- Stem -->\n      <line x1=\"110\" y1=\"35\" x2=\"110\" y2=\"100\" stroke-width=\"4\" stroke=\"currentColor\" />\n      <!-- Packing Nut -->\n      <rect x=\"95\" y=\"40\" width=\"30\" height=\"12\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" />\n      <!-- Gland / Stuffing Box (Where Packing is located) -->\n      <rect x=\"90\" y=\"52\" width=\"40\" height=\"20\" fill=\"none\" stroke=\"currentColor\" />\n      <!-- Inside packing material layers -->\n      <rect x=\"95\" y=\"54\" width=\"30\" height=\"16\" fill=\"currentColor\" opacity=\"0.3\" class=\"text-amber-500\" />\n      <line x1=\"95\" y1=\"62\" x2=\"125\" y2=\"62\" stroke-width=\"1.5\" stroke=\"currentColor\" />\n      <!-- Bonnet -->\n      <path d=\"M80 72 H140 L135 110 H85 Z\" fill=\"none\" stroke=\"currentColor\" />\n      <!-- Valve Body -->\n      <path d=\"M50 110 H170 V150 H150 V160 H70 V150 H50 Z\" fill=\"none\" stroke=\"currentColor\" />\n      <!-- Flanges -->\n      <rect x=\"35\" y=\"105\" width=\"15\" height=\"50\" rx=\"2\" stroke=\"currentColor\" />\n      <rect x=\"170\" y=\"105\" width=\"15\" height=\"50\" rx=\"2\" stroke=\"currentColor\" />\n      <!-- Indicator Arrow pointing to the Packing layers -->\n      <g class=\"text-[#ef4444] stroke-current font-bold\" stroke-width=\"2.5\">\n        <path d=\"M185 62 H135\" stroke=\"currentColor\" />\n        <path d=\"M142 55 L135 62 L142 69\" fill=\"none\" stroke=\"currentColor\" />\n        <text x=\"195\" y=\"68\" font-size=\"22\" font-family=\"sans-serif\" font-weight=\"900\" stroke=\"none\" fill=\"currentColor\">?</text>\n      </g>\n    </svg>`\n  }"
