  file_change {
    absolute_path_uri: "file:///index.html"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "<!DOCTYPE html>\n<html lang=\"en\" class=\"light\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Master\'s Mastery Test: SPDI Set A</title>\n  \n  <!-- Tailwind CSS v3 CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  \n  <!-- Lucide Icons CDN -->\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  \n  <script>\n    tailwind.config = {\n      darkMode: \'class\',\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              50: \'#f5f3ff\',\n              100: \'#ede9fe\',\n              500: \'#6366f1\',\n              600: \'#4f46e5\',\n              700: \'#4338ca\',\n            }\n          },\n          fontFamily: {\n            sans: [\'Inter\', \'ui-sans-serif\', \'system-ui\', \'sans-serif\'],\n            mono: [\'JetBrains Mono\', \'ui-monospace\', \'monospace\']\n          }\n        }\n      }\n    }\n  </script>\n  \n  <style>\n    @import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\');\n    \n    body {\n      font-family: \'Inter\', sans-serif;\n    }\n    \n    /* Custom Scrollbar for elegant navigator panel */\n    ::-webkit-scrollbar {\n      width: 6px;\n      height: 6px;\n    }\n    ::-webkit-scrollbar-track {\n      background: transparent;\n    }\n    ::-webkit-scrollbar-thumb {\n      background: rgba(156, 163, 175, 0.4);\n      border-radius: 4px;\n    }\n    ::-webkit-scrollbar-thumb:hover {\n      background: rgba(156, 163, 175, 0.6);\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-100 min-h-screen transition-colors duration-200\">\n\n  <!-- TOP DECORATION BAR -->\n  <div class=\"h-1.5 w-full bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500\"></div>\n\n  <!-- HEADER -->\n  <header class=\"border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-40\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between\">\n      <div class=\"flex items-center space-x-3\">\n        <div class=\"p-2 bg-indigo-50 dark:bg-indigo-950/50 rounded-xl text-indigo-600 dark:text-indigo-400\">\n          <i data-lucide=\"award\" class=\"w-6 h-6\"></i>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold tracking-tight text-slate-900 dark:text-white\">Master\'s Mastery</h1>\n          <p class=\"text-xs text-slate-500 dark:text-slate-400 font-medium\">SPDI Set A Reviewer</p>\n        </div>\n      </div>\n      \n      <!-- HEADER CONTROLS -->\n      <div class=\"flex items-center space-x-3\">\n        <!-- THEME TOGGLE -->\n        <button id=\"theme-toggle\" class=\"p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800 transition-colors\" title=\"Toggle theme\">\n          <i data-lucide=\"sun\" class=\"w-5 h-5 hidden dark:block\"></i>\n          <i data-lucide=\"moon\" class=\"w-5 h-5 block dark:hidden\"></i>\n        </button>\n\n        <!-- HELP / INFO TRIGGER -->\n        <button id=\"help-toggle\" class=\"p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800 transition-colors\" title=\"Keyboard Shortcuts\">\n          <i data-lucide=\"keyboard\" class=\"w-5 h-5\"></i>\n        </button>\n\n        <!-- RESET STATE -->\n        <button id=\"reset-test-btn\" class=\"p-2 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/20 transition-colors\" title=\"Reset all answers\">\n          <i data-lucide=\"rotate-ccw\" class=\"w-5 h-5\"></i>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- KEYBOARD SHORTCUTS MODAL FALLBACK (INLINE DISMISSIBLE ALERT) -->\n  <div id=\"shortcuts-helper\" class=\"hidden bg-indigo-50 dark:bg-indigo-950/40 border-b border-indigo-100 dark:border-indigo-900/50 transition-all duration-200\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between text-xs text-indigo-800 dark:text-indigo-300\">\n      <div class=\"flex flex-wrap items-center gap-4\">\n        <span class=\"font-semibold\"><i data-lucide=\"zap\" class=\"w-4 h-4 inline mr-1\"></i> Quick Shortcuts:</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">\342\206\220</kbd> Previous</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">\342\206\222</kbd> Next</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">1</kbd> - <kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">4</kbd> Select Answer</span>\n      </div>\n      <button onclick=\"toggleShortcutsHelper()\" class=\"text-indigo-500 hover:text-indigo-700 dark:hover:text-indigo-100 p-1\">\n        <i data-lucide=\"x\" class=\"w-4 h-4\"></i>\n      </button>\n    </div>\n  </div>\n\n  <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n      \n      <!-- MAIN STUDY PORTION (8 COLS) -->\n      <div class=\"lg:col-span-8 space-y-6\">\n        \n        <!-- EXAM DESCRIPTIVE CARD (COLLAPSIBLE / PERSISTED DISMISSED) -->\n        <div id=\"welcome-card\" class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm relative overflow-hidden\">\n          <div class=\"absolute right-0 top-0 w-24 h-24 bg-indigo-500/10 rounded-full blur-xl\"></div>\n          <button onclick=\"dismissWelcome()\" class=\"absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200\">\n            <i data-lucide=\"x\" class=\"w-5 h-5\"></i>\n          </button>\n          <h2 class=\"text-xl font-bold text-slate-900 dark:text-white mb-2\">Master\'s Mastery Test: SPDI Set A</h2>\n          <p class=\"text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4\">\n            This comprehensive practice exam consists of 76 specialized multiple-choice questions focusing on sanitary systems, water supply piping, fire protection sprinklers, and plumbing regulations.\n          </p>\n          <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-semibold\">\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Passing Grade</span>\n              <span class=\"text-indigo-600 dark:text-indigo-400 text-sm\">70% (54 / 76)</span>\n            </div>\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Total Items</span>\n              <span id=\"items-count\" class=\"text-indigo-600 dark:text-indigo-400 text-sm\">76 Questions</span>\n            </div>\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Study Modes</span>\n              <span class=\"text-indigo-600 dark:text-indigo-400 text-sm\">Shuffle & Targeted Review</span>\n            </div>\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Status</span>\n              <span id=\"status-badge\" class=\"text-amber-600 dark:text-amber-400 text-sm\">Practice Active</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- PROGRESS BAR -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-100 dark:border-slate-800 shadow-sm\">\n          <div class=\"flex items-center justify-between text-xs font-semibold mb-2\">\n            <div class=\"flex items-center space-x-2 text-indigo-600 dark:text-indigo-400\">\n              <i data-lucide=\"check-circle\" class=\"w-4 h-4\"></i>\n              <span id=\"answered-indicator\">0 of 76 Answered</span>\n            </div>\n            <span id=\"progress-percentage-text\" class=\"text-slate-500 dark:text-slate-400\">0% Done</span>\n          </div>\n          <div class=\"h-2 w-full bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden\">\n            <div id=\"progress-fill\" class=\"h-full bg-indigo-500 rounded-full transition-all duration-300\" style=\"width: 0%\"></div>\n          </div>\n        </div>\n\n        <!-- MAIN QUESTION CARD -->\n        <div id=\"question-card\" class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 sm:p-8 border border-slate-100 dark:border-slate-800 shadow-sm space-y-6 transition-all duration-200\">\n          \n          <!-- Question Header -->\n          <div class=\"flex items-center justify-between\">\n            <span id=\"question-index-label\" class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 px-3 py-1.5 rounded-full\">\n              Question 1 of 76\n            </span>\n            <div class=\"flex items-center space-x-1.5\">\n              <span id=\"question-points\" class=\"text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-900 px-2.5 py-1.5 rounded-md\">\n                1 Point\n              </span>\n            </div>\n          </div>\n\n          <!-- Question Body -->\n          <div>\n            <h3 id=\"question-text\" class=\"text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-relaxed\">\n              Loading Question...\n            </h3>\n          </div>\n\n          <!-- OPTIONAL MEDIA PREVIEW -->\n          <div id=\"question-media-container\" class=\"hidden flex justify-center bg-slate-50 dark:bg-slate-900 p-4 rounded-xl border border-slate-100 dark:border-slate-800\">\n            <img id=\"question-image\" src=\"\" alt=\"Question Attachment\" class=\"max-h-72 object-contain rounded shadow-sm\">\n          </div>\n\n          <!-- ANSWER CHOICES CONTAINER -->\n          <div id=\"choices-container\" class=\"grid grid-cols-1 gap-3.5\">\n            <!-- Choices injected dynamically -->\n          </div>\n\n          <!-- SUBMIT FEEDBACK (Shown after submission) -->\n          <div id=\"answer-feedback\" class=\"hidden p-4 rounded-xl border flex items-start space-x-3\">\n            <div id=\"feedback-icon-container\" class=\"p-1 rounded-full text-white mt-0.5\">\n              <!-- Icon dynamically selected -->\n            </div>\n            <div>\n              <h4 id=\"feedback-title\" class=\"font-bold text-sm\">Correct</h4>\n              <p id=\"feedback-desc\" class=\"text-xs text-slate-600 dark:text-slate-300 mt-0.5\"></p>\n            </div>\n          </div>\n        </div>\n\n        <!-- NAVIGATION CONTROLS -->\n        <div class=\"flex items-center justify-between\">\n          <button id=\"prev-btn\" class=\"px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 font-bold text-sm flex items-center space-x-2 transition-colors\">\n            <i data-lucide=\"chevron-left\" class=\"w-4 h-4\"></i>\n            <span>Previous</span>\n          </button>\n          \n          <button id=\"next-btn\" class=\"px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 font-bold text-sm flex items-center space-x-2 transition-colors\">\n            <span>Next</span>\n            <i data-lucide=\"chevron-right\" class=\"w-4 h-4\"></i>\n          </button>\n        </div>\n\n        <!-- FORM FINALIZE BLOCK (Submit test) -->\n        <div id=\"submit-section\" class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div class=\"space-y-1 text-center sm:text-left\">\n            <h4 class=\"font-bold text-sm text-slate-900 dark:text-white\">Ready to finalize?</h4>\n            <p class=\"text-xs text-slate-500 dark:text-slate-400\">Ensure you\'ve answered as much as possible before submitting your score.</p>\n          </div>\n          <button id=\"submit-test-btn\" class=\"w-full sm:w-auto px-8 py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/20 hover:shadow-indigo-500/30 transition-all\">\n            Submit Exam\n          </button>\n        </div>\n\n      </div>\n\n      <!-- SIDEBAR SETTINGS & QUESTION NAVIGATOR (4 COLS) -->\n      <div class=\"lg:col-span-4 space-y-6\">\n        \n        <!-- EXAM CONTROLS CARD -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm space-y-5\">\n          <h3 class=\"font-bold text-slate-900 dark:text-white flex items-center space-x-2\">\n            <i data-lucide=\"settings\" class=\"w-4 h-4 text-indigo-500\"></i>\n            <span>Exam Settings</span>\n          </h3>\n\n          <div class=\"space-y-4 text-sm font-semibold\">\n            <!-- Shuffle Questions -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-slate-600 dark:text-slate-300 group-hover:text-slate-950 dark:group-hover:text-white transition-colors\">Shuffle Questions</span>\n              <input type=\"checkbox\" id=\"shuffle-questions-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative\"></div>\n            </label>\n\n            <!-- Shuffle Choices -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-slate-600 dark:text-slate-300 group-hover:text-slate-950 dark:group-hover:text-white transition-colors\">Shuffle Choices</span>\n              <input type=\"checkbox\" id=\"shuffle-choices-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative\"></div>\n            </label>\n\n            <!-- Targeted Study: Review Incorrect -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-slate-600 dark:text-slate-300 group-hover:text-slate-950 dark:group-hover:text-white transition-colors\">Review Incorrect Only</span>\n              <input type=\"checkbox\" id=\"review-incorrect-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative\"></div>\n            </label>\n          </div>\n        </div>\n\n        <!-- SEARCH BAR -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-100 dark:border-slate-800 shadow-sm relative\">\n          <input type=\"text\" id=\"search-input\" placeholder=\"Search questions...\" class=\"w-full text-sm pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors dark:text-white\">\n          <div class=\"absolute left-7 top-5 text-slate-400 dark:text-slate-500\">\n            <i data-lucide=\"search\" class=\"w-4 h-4\"></i>\n          </div>\n        </div>\n\n        <!-- QUESTION NAVIGATOR GRID -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm space-y-4\">\n          <div class=\"flex items-center justify-between\">\n            <h3 class=\"font-bold text-slate-900 dark:text-white flex items-center space-x-2\">\n              <i data-lucide=\"grid\" class=\"w-4 h-4 text-indigo-500\"></i>\n              <span>Navigator</span>\n            </h3>\n            <span id=\"nav-count\" class=\"text-xs font-semibold bg-slate-100 dark:bg-slate-900 px-2 py-1 rounded-md text-slate-500 dark:text-slate-400\">\n              0 / 76\n            </span>\n          </div>\n\n          <!-- Color Legends -->\n          <div class=\"flex flex-wrap gap-2 text-[10px] font-semibold text-slate-500\">\n            <div class=\"flex items-center space-x-1\">\n              <span class=\"w-2.5 h-2.5 rounded bg-slate-200 dark:bg-slate-700\"></span>\n              <span>Unanswered</span>\n            </div>\n            <div class=\"flex items-center space-x-1\">\n              <span class=\"w-2.5 h-2.5 rounded bg-indigo-500\"></span>\n              <span>Answered</span>\n            </div>\n            <div class=\"flex items-center space-x-1 post-submit-only hidden\">\n              <span class=\"w-2.5 h-2.5 rounded bg-emerald-500\"></span>\n              <span>Correct</span>\n            </div>\n            <div class=\"flex items-center space-x-1 post-submit-only hidden\">\n              <span class=\"w-2.5 h-2.5 rounded bg-rose-500\"></span>\n              <span>Incorrect</span>\n            </div>\n          </div>\n\n          <!-- Scrollable Grid Container -->\n          <div class=\"max-h-[340px] overflow-y-auto pr-1\">\n            <div id=\"navigator-grid\" class=\"grid grid-cols-6 sm:grid-cols-8 md:grid-cols-10 lg:grid-cols-6 gap-2\">\n              <!-- Grid items injected dynamically -->\n            </div>\n          </div>\n        </div>\n\n        <!-- RESET CONFIRM DIALOG -->\n        <div id=\"reset-confirm-panel\" class=\"hidden bg-rose-50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/50 rounded-xl p-4 text-center space-y-3\">\n          <p class=\"text-xs font-bold text-rose-800 dark:text-rose-300\">Are you sure? This deletes saved answers, score, and shuffles.</p>\n          <div class=\"flex items-center justify-center space-x-2 text-xs\">\n            <button onclick=\"confirmReset()\" class=\"px-4 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded font-bold\">Yes, Reset</button>\n            <button onclick=\"cancelReset()\" class=\"px-4 py-1.5 bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 text-slate-700 dark:text-slate-300 rounded font-semibold\">Cancel</button>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  </main>\n\n  <!-- OVERLAY SCORE BOARD (Shown after Submission) -->\n  <div id=\"results-modal\" class=\"hidden fixed inset-0 bg-slate-900/60 dark:bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n    <div class=\"bg-white dark:bg-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 border border-slate-100 dark:border-slate-800 shadow-2xl relative space-y-6 overflow-hidden\">\n      <div class=\"absolute right-0 top-0 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl\"></div>\n      \n      <div class=\"text-center space-y-2\">\n        <div class=\"inline-flex p-3 bg-indigo-50 dark:bg-indigo-950/50 rounded-full text-indigo-600 dark:text-indigo-400 mb-1\">\n          <i data-lucide=\"check-square\" class=\"w-10 h-10\"></i>\n        </div>\n        <h2 class=\"text-2xl font-black text-slate-900 dark:text-white tracking-tight\">Master\'s Mastery Test Results</h2>\n        <p class=\"text-xs text-slate-500 dark:text-slate-400 uppercase tracking-widest font-extrabold\">Final Performance Summary</p>\n      </div>\n\n      <!-- Dynamic Score Circular Display -->\n      <div class=\"flex flex-col items-center justify-center space-y-2 py-4\">\n        <div class=\"relative w-36 h-36 flex items-center justify-center\">\n          <!-- Circular ring fallback -->\n          <svg class=\"absolute inset-0 w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\">\n            <circle class=\"text-slate-100 dark:text-slate-700\" stroke-width=\"8\" stroke=\"currentColor\" fill=\"transparent\" r=\"40\" cx=\"50\" cy=\"50\"/>\n            <circle id=\"circle-progress\" class=\"text-indigo-500\" stroke-width=\"8\" stroke-dasharray=\"251.2\" stroke-dashoffset=\"251.2\" stroke-linecap=\"round\" stroke=\"currentColor\" fill=\"transparent\" r=\"40\" cx=\"50\" cy=\"50\"/>\n          </svg>\n          <div class=\"text-center\">\n            <span id=\"results-percentage\" class=\"text-3xl font-black block text-slate-900 dark:text-white\">0%</span>\n            <span id=\"results-fraction\" class=\"text-xs text-slate-500 dark:text-slate-400 font-semibold\">0 / 76 Correct</span>\n          </div>\n        </div>\n        <span id=\"results-feedback-pill\" class=\"px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider mt-2\">\n          Grade: FAIL\n        </span>\n      </div>\n\n      <!-- Score Breakdowns -->\n      <div class=\"space-y-3\">\n        <div class=\"flex items-center justify-between text-xs font-semibold p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n          <span class=\"text-slate-500\">Minimum Passing Threshold</span>\n          <span class=\"text-slate-800 dark:text-slate-200\">70% (54 Correct Answers)</span>\n        </div>\n        <div class=\"flex items-center justify-between text-xs font-semibold p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n          <span class=\"text-slate-500\">Total Items Attempted</span>\n          <span id=\"results-attempted\" class=\"text-slate-800 dark:text-slate-200\">0 of 76</span>\n        </div>\n      </div>\n\n      <!-- Action items -->\n      <div class=\"grid grid-cols-2 gap-3 pt-2\">\n        <button onclick=\"dismissResults()\" class=\"px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 font-bold text-sm text-slate-700 dark:text-slate-200 transition-all\">\n          Review Answers\n        </button>\n        <button onclick=\"retakeExam()\" class=\"px-5 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md transition-all\">\n          Retake Exam\n        </button>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- LOAD THE QUESTION DATABASE SCRIPT FIRST -->\n  <script src=\"./src/questions.js\"></script>\n\n  <!-- APPLICATION CONTROLLER -->\n  <script>\n    // State management variables\n    let questions = []; // Stores the master list of questions\n    let userAnswers = {}; // key: question ID, value: selected choice\n    let currentIdx = 0; // index of active question\n    let isGraded = false; // flag indicating if test is scored\n    let reviewIncorrectOnly = false; // toggle study mode\n    let shuffledQuestionsPool = null; // optional randomized indexing array\n    let shuffledChoicesPool = {}; // key: question ID, value: randomized choice indices\n    let originalIndicesMap = []; // Maps current index to original indices\n\n    // Settings\n    let shuffleQuestionsEnabled = false;\n    let shuffleChoicesEnabled = false;\n\n    // Local Storage keys\n    const LS_KEY_ANSWERS = \"spdi_user_answers\";\n    const LS_KEY_IDX = \"spdi_current_idx\";\n    const LS_KEY_GRADED = \"spdi_is_graded\";\n    const LS_KEY_WELCOME = \"spdi_welcome_dismissed\";\n    const LS_KEY_SHUFFLE_Q = \"spdi_shuffle_questions\";\n    const LS_KEY_SHUFFLE_C = \"spdi_shuffle_choices\";\n    const LS_KEY_THEME = \"spdi_theme_dark\";\n\n    // Initialize the whole test\n    function init() {\n      // Get correct dataset\n      if (window.questionsData && Array.isArray(window.questionsData)) {\n        questions = window.questionsData;\n      } else {\n        console.error(\"questionsData not found or corrupted.\");\n        return;\n      }\n\n      // Check Saved Theme\n      const isDark = localStorage.getItem(LS_KEY_THEME) === \"true\";\n      if (isDark) {\n        document.documentElement.classList.add(\'dark\');\n        document.documentElement.classList.remove(\'light\');\n      } else {\n        document.documentElement.classList.remove(\'dark\');\n        document.documentElement.classList.add(\'light\');\n      }\n\n      // Read saved welcomes\n      if (localStorage.getItem(LS_KEY_WELCOME) === \"true\") {\n        document.getElementById(\'welcome-card\').classList.add(\'hidden\');\n      }\n\n      // Read saved configurations\n      shuffleQuestionsEnabled = localStorage.getItem(LS_KEY_SHUFFLE_Q) === \"true\";\n      shuffleChoicesEnabled = localStorage.getItem(LS_KEY_SHUFFLE_C) === \"true\";\n\n      document.getElementById(\'shuffle-questions-toggle\').checked = shuffleQuestionsEnabled;\n      document.getElementById(\'shuffle-choices-toggle\').checked = shuffleChoicesEnabled;\n\n      // Restore userAnswers\n      const savedAnswers = localStorage.getItem(LS_KEY_ANSWERS);\n      if (savedAnswers) {\n        try {\n          userAnswers = JSON.parse(savedAnswers);\n        } catch(e) {\n          userAnswers = {};\n        }\n      }\n\n      // Restore graded status\n      isGraded = localStorage.getItem(LS_KEY_GRADED) === \"true\";\n\n      // Setup list structures\n      buildIndicesMap();\n\n      // Restore current index\n      const savedIdx = localStorage.getItem(LS_KEY_IDX);\n      if (savedIdx !== null) {\n        const parsed = parseInt(savedIdx);\n        if (!isNaN(parsed) && parsed >= 0 && parsed < originalIndicesMap.length) {\n          currentIdx = parsed;\n        }\n      }\n\n      // Render Everything\n      renderProgress();\n      renderActiveQuestion();\n      renderNavigator();\n\n      // Post-Submit Setup\n      if (isGraded) {\n        revealGradedStates();\n      }\n\n      // Lucide icons render\n      lucide.createIcons();\n    }\n\n    // Map logic mapping virtual indices (what user is viewing) to real data indices\n    function buildIndicesMap() {\n      const size = questions.length;\n      let indices = Array.from({length: size}, (_, i) => i);\n\n      // Shuffling questions\n      if (shuffleQuestionsEnabled) {\n        // Simple seeded random mapping or true random persisted in localStorage\n        const poolKey = \"spdi_shuffled_pool_indices\";\n        let savedPool = localStorage.getItem(poolKey);\n        if (savedPool) {\n          indices = JSON.parse(savedPool);\n        } else {\n          // Shuffle algorithm\n          for (let i = indices.length - 1; i > 0; i--) {\n            const j = Math.floor(Math.random() * (i + 1));\n            [indices[i], indices[j]] = [indices[j], indices[i]];\n          }\n          localStorage.setItem(poolKey, JSON.stringify(indices));\n        }\n      } else {\n        localStorage.removeItem(\"spdi_shuffled_pool_indices\");\n      }\n\n      // Study incorrect answers only\n      if (reviewIncorrectOnly) {\n        indices = indices.filter(idx => {\n          const q = questions[idx];\n          const selected = userAnswers[q.id];\n          return !selected || selected !== q.correctAnswer;\n        });\n      }\n\n      originalIndicesMap = indices;\n\n      // Prevent empty states\n      if (originalIndicesMap.length === 0) {\n        if (reviewIncorrectOnly) {\n          // No incorrect answers to review, toggle off\n          reviewIncorrectOnly = false;\n          document.getElementById(\'review-incorrect-toggle\').checked = false;\n          buildIndicesMap();\n        } else {\n          originalIndicesMap = Array.from({length: size}, (_, i) => i);\n        }\n      }\n\n      // Normalize currentIdx\n      if (currentIdx >= originalIndicesMap.length) {\n        currentIdx = 0;\n      }\n    }\n\n    // Save index\n    function saveIndexState() {\n      localStorage.setItem(LS_KEY_IDX, currentIdx.toString());\n    }\n\n    // Progress Bar Render\n    function renderProgress() {\n      const total = questions.length;\n      const count = Object.keys(userAnswers).length;\n      const percentage = total > 0 ? Math.round((count / total) * 100) : 0;\n\n      document.getElementById(\'answered-indicator\').innerText = `${count} of ${total} Answered`;\n      document.getElementById(\'progress-percentage-text\').innerText = `${percentage}% Done`;\n      document.getElementById(\'progress-fill\').style.width = `${percentage}%`;\n      document.getElementById(\'nav-count\').innerText = `${count} / ${total}`;\n    }\n\n    // Render Navigator grid panel\n    function renderNavigator() {\n      const grid = document.getElementById(\'navigator-grid\');\n      grid.innerHTML = \"\";\n\n      originalIndicesMap.forEach((realIdx, virtualIdx) => {\n        const q = questions[realIdx];\n        const isAnswered = !!userAnswers[q.id];\n        const isCurrent = virtualIdx === currentIdx;\n\n        const btn = document.createElement(\'button\');\n        btn.id = `nav-item-${virtualIdx}`;\n        btn.type = \"button\";\n        btn.className = \"aspect-square rounded-lg font-bold text-xs flex items-center justify-center border transition-all duration-200 \";\n\n        // Text content\n        btn.innerText = (virtualIdx + 1).toString();\n\n        // Apply theme/status colors\n        if (isCurrent) {\n          btn.classList.add(\"ring-2\", \"ring-indigo-600\", \"ring-offset-2\", \"dark:ring-offset-slate-900\");\n        }\n\n        if (isGraded) {\n          const isCorrect = userAnswers[q.id] === q.correctAnswer;\n          if (isCorrect) {\n            btn.classList.add(\"bg-emerald-500\", \"border-emerald-600\", \"text-white\");\n          } else {\n            btn.classList.add(\"bg-rose-500\", \"border-rose-600\", \"text-white\");\n          }\n        } else {\n          if (isAnswered) {\n            btn.classList.add(\"bg-indigo-600\", \"border-indigo-600\", \"text-white\");\n          } else {\n            btn.classList.add(\"bg-slate-100\", \"dark:bg-slate-800\", \"border-slate-200\", \"dark:border-slate-700\", \"text-slate-700\", \"dark:text-slate-300\");\n          }\n        }\n\n        // Search highlight\n        const searchTerm = document.getElementById(\'search-input\').value.toLowerCase();\n        if (searchTerm && q.question.toLowerCase().includes(searchTerm)) {\n          btn.classList.add(\"ring-2\", \"ring-amber-500\");\n        }\n\n        // On Click event\n        btn.onclick = () => {\n          currentIdx = virtualIdx;\n          saveIndexState();\n          renderActiveQuestion();\n          renderNavigator();\n        };\n\n        grid.appendChild(btn);\n      });\n    }\n\n    // Render Current Selected Question\n    function renderActiveQuestion() {\n      if (originalIndicesMap.length === 0) return;\n      const realIdx = originalIndicesMap[currentIdx];\n      const q = questions[realIdx];\n\n      // Label Header\n      document.getElementById(\'question-index-label\').innerText = `Question ${currentIdx + 1} of ${originalIndicesMap.length}`;\n      \n      // Question Text\n      document.getElementById(\'question-text\').innerText = q.question;\n\n      // Question Media (Attachment)\n      const mediaBox = document.getElementById(\'question-media-container\');\n      const img = document.getElementById(\'question-image\');\n      if (q.image) {\n        img.src = q.image;\n        mediaBox.classList.remove(\'hidden\');\n      } else {\n        mediaBox.classList.add(\'hidden\');\n      }\n\n      // Options Rendering\n      const choicesBox = document.getElementById(\'choices-container\');\n      choicesBox.innerHTML = \"\";\n\n      // Shuffling choices logic\n      let choicesOrder = Array.from({length: q.choices.length}, (_, i) => i);\n      if (shuffleChoicesEnabled) {\n        if (!shuffledChoicesPool[q.id]) {\n          // Shuffle index order and persist in state\n          for (let i = choicesOrder.length - 1; i > 0; i--) {\n            const j = Math.floor(Math.random() * (i + 1));\n            [choicesOrder[i], choicesOrder[j]] = [choicesOrder[j], choicesOrder[i]];\n          }\n          shuffledChoicesPool[q.id] = choicesOrder;\n        } else {\n          choicesOrder = shuffledChoicesPool[q.id];\n        }\n      }\n\n      choicesOrder.forEach((idx, listPosition) => {\n        const choice = q.choices[idx];\n        const isSelected = userAnswers[q.id] === choice;\n\n        const choiceBtn = document.createElement(\'button\');\n        choiceBtn.type = \"button\";\n        choiceBtn.className = \"w-full text-left p-4 rounded-xl border flex items-center justify-between transition-all duration-200 font-semibold text-sm group \";\n\n        // Option prefix letter badge\n        const prefix = String.fromCharCode(65 + listPosition); // A, B, C, D...\n\n        // Left wrapper\n        const leftWrap = document.createElement(\'div\');\n        leftWrap.className = \"flex items-center space-x-3.5\";\n\n        const letterBadge = document.createElement(\'span\');\n        letterBadge.className = \"w-7 h-7 rounded-lg flex items-center justify-center text-xs font-black transition-colors \";\n        letterBadge.innerText = prefix;\n\n        const textSpan = document.createElement(\'span\');\n        textSpan.innerText = choice;\n        textSpan.className = \"text-slate-800 dark:text-slate-100\";\n\n        leftWrap.appendChild(letterBadge);\n        leftWrap.appendChild(textSpan);\n        choiceBtn.appendChild(leftWrap);\n\n        // Selection states\n        if (isSelected) {\n          choiceBtn.classList.add(\"bg-indigo-50\", \"border-indigo-500\", \"dark:bg-indigo-950/30\", \"dark:border-indigo-400\");\n          letterBadge.className += \" bg-indigo-500 text-white\";\n        } else {\n          choiceBtn.classList.add(\"bg-white\", \"dark:bg-slate-800\", \"border-slate-200\", \"dark:border-slate-700\", \"hover:border-slate-300\", \"dark:hover:border-slate-600\");\n          letterBadge.className += \" bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 group-hover:bg-slate-200\";\n        }\n\n        // Post submit color states\n        if (isGraded) {\n          choiceBtn.disabled = true; // Disable changes after grading\n          if (choice === q.correctAnswer) {\n            // Highlight correct in green\n            choiceBtn.classList.remove(\"bg-white\", \"dark:bg-slate-800\", \"bg-indigo-50\", \"border-indigo-500\");\n            choiceBtn.classList.add(\"bg-emerald-50/70\", \"border-emerald-500\", \"dark:bg-emerald-950/20\", \"dark:border-emerald-400\");\n            letterBadge.className = \"w-7 h-7 rounded-lg flex items-center justify-center text-xs font-black bg-emerald-500 text-white\";\n            \n            const checkIcon = document.createElement(\'i\');\n            checkIcon.setAttribute(\'data-lucide\', \'check\');\n            checkIcon.className = \"w-5 h-5 text-emerald-500\";\n            choiceBtn.appendChild(checkIcon);\n          } else if (isSelected) {\n            // Selected but incorrect\n            choiceBtn.classList.remove(\"bg-white\", \"dark:bg-slate-800\", \"bg-indigo-50\", \"border-indigo-500\");\n            choiceBtn.classList.add(\"bg-rose-50/70\", \"border-rose-500\", \"dark:bg-rose-950/20\", \"dark:border-rose-400\");\n            letterBadge.className = \"w-7 h-7 rounded-lg flex items-center justify-center text-xs font-black bg-rose-500 text-white\";\n            \n            const xIcon = document.createElement(\'i\');\n            xIcon.setAttribute(\'data-lucide\', \'x\');\n            xIcon.className = \"w-5 h-5 text-rose-500\";\n            choiceBtn.appendChild(xIcon);\n          }\n        } else {\n          // Add Select Action click listener\n          choiceBtn.onclick = () => {\n            userAnswers[q.id] = choice;\n            localStorage.setItem(LS_KEY_ANSWERS, JSON.stringify(userAnswers));\n            renderActiveQuestion();\n            renderProgress();\n            renderNavigator();\n          };\n        }\n\n        choicesBox.appendChild(choiceBtn);\n      });\n\n      // Show/Hide answer feedback if graded\n      const fbBox = document.getElementById(\'answer-feedback\');\n      if (isGraded) {\n        fbBox.classList.remove(\'hidden\');\n        const isCorrect = userAnswers[q.id] === q.correctAnswer;\n        const iconWrap = document.getElementById(\'feedback-icon-container\');\n        iconWrap.innerHTML = \"\";\n\n        const fIcon = document.createElement(\'i\');\n        \n        if (isCorrect) {\n          fbBox.className = \"p-4 rounded-xl border flex items-start space-x-3 bg-emerald-50/40 border-emerald-100 dark:bg-emerald-950/10 dark:border-emerald-900/30 text-emerald-800 dark:text-emerald-300\";\n          iconWrap.className = \"p-1 rounded-full bg-emerald-500 text-white mt-0.5\";\n          fIcon.setAttribute(\'data-lucide\', \'thumbs-up\');\n          document.getElementById(\'feedback-title\').innerText = \"Correct Choice!\";\n          document.getElementById(\'feedback-desc\').innerText = `You correctly selected: \"${q.correctAnswer}\". Excellent!`;\n        } else {\n          fbBox.className = \"p-4 rounded-xl border flex items-start space-x-3 bg-rose-50/40 border-rose-100 dark:bg-rose-950/10 dark:border-rose-900/30 text-rose-800 dark:text-rose-300\";\n          iconWrap.className = \"p-1 rounded-full bg-rose-500 text-white mt-0.5\";\n          fIcon.setAttribute(\'data-lucide\', \'alert-circle\');\n          document.getElementById(\'feedback-title\').innerText = \"Incorrect\";\n          document.getElementById(\'feedback-desc\').innerText = `The correct answer is: \"${q.correctAnswer}\". Your selection: \"${userAnswers[q.id] || \"No Answer\"}\".`;\n        }\n        iconWrap.appendChild(fIcon);\n      } else {\n        fbBox.classList.add(\'hidden\');\n      }\n\n      // Refresh lucide icons in dynamic components\n      lucide.createIcons();\n    }\n\n    // Toggle help modal info\n    function toggleShortcutsHelper() {\n      const helper = document.getElementById(\'shortcuts-helper\');\n      helper.classList.toggle(\'hidden\');\n    }\n\n    // Dismiss Welcome banner card\n    function dismissWelcome() {\n      document.getElementById(\'welcome-card\').classList.add(\'hidden\');\n      localStorage.setItem(LS_KEY_WELCOME, \"true\");\n    }\n\n    // Trigger reset test state\n    document.getElementById(\'reset-test-btn\').onclick = () => {\n      document.getElementById(\'reset-confirm-panel\').classList.remove(\'hidden\');\n    };\n\n    function cancelReset() {\n      document.getElementById(\'reset-confirm-panel\').classList.add(\'hidden\');\n    }\n\n    function confirmReset() {\n      localStorage.removeItem(LS_KEY_ANSWERS);\n      localStorage.removeItem(LS_KEY_IDX);\n      localStorage.removeItem(LS_KEY_GRADED);\n      localStorage.removeItem(\"spdi_shuffled_pool_indices\");\n      userAnswers = {};\n      isGraded = false;\n      currentIdx = 0;\n      shuffledChoicesPool = {};\n      \n      // Hide post-submit legends\n      document.querySelectorAll(\'.post-submit-only\').forEach(el => el.classList.add(\'hidden\'));\n\n      buildIndicesMap();\n      init();\n      cancelReset();\n    }\n\n    // Settings adjustments listeners\n    document.getElementById(\'shuffle-questions-toggle\').onchange = (e) => {\n      shuffleQuestionsEnabled = e.target.checked;\n      localStorage.setItem(LS_KEY_SHUFFLE_Q, shuffleQuestionsEnabled.toString());\n      localStorage.removeItem(\"spdi_shuffled_pool_indices\");\n      buildIndicesMap();\n      renderNavigator();\n      renderActiveQuestion();\n    };\n\n    document.getElementById(\'shuffle-choices-toggle\').onchange = (e) => {\n      shuffleChoicesEnabled = e.target.checked;\n      localStorage.setItem(LS_KEY_SHUFFLE_C, shuffleChoicesEnabled.toString());\n      shuffledChoicesPool = {};\n      renderActiveQuestion();\n    };\n\n    document.getElementById(\'review-incorrect-toggle\').onchange = (e) => {\n      reviewIncorrectOnly = e.target.checked;\n      buildIndicesMap();\n      renderNavigator();\n      renderActiveQuestion();\n    };\n\n    // Dark Mode Toggle Trigger\n    document.getElementById(\'theme-toggle\').onclick = () => {\n      const root = document.documentElement;\n      const isCurrentlyDark = root.classList.contains(\'dark\');\n      if (isCurrentlyDark) {\n        root.classList.remove(\'dark\');\n        root.classList.add(\'light\');\n        localStorage.setItem(LS_KEY_THEME, \"false\");\n      } else {\n        root.classList.add(\'dark\');\n        root.classList.remove(\'light\');\n        localStorage.setItem(LS_KEY_THEME, \"true\");\n      }\n    };\n\n    // Keyboard bindings hook\n    window.addEventListener(\'keydown\', (e) => {\n      // Ignore if user is searching\n      if (document.activeElement === document.getElementById(\'search-input\')) {\n        return;\n      }\n\n      if (e.key === \'ArrowLeft\') {\n        // Prev\n        if (currentIdx > 0) {\n          currentIdx--;\n          saveIndexState();\n          renderActiveQuestion();\n          renderNavigator();\n        }\n      } else if (e.key === \'ArrowRight\') {\n        // Next\n        if (currentIdx < originalIndicesMap.length - 1) {\n          currentIdx++;\n          saveIndexState();\n          renderActiveQuestion();\n          renderNavigator();\n        }\n      } else if (e.key >= \'1\' && e.key <= \'5\' && !isGraded) {\n        // Options choice select\n        const optionIdx = parseInt(e.key) - 1;\n        const realIdx = originalIndicesMap[currentIdx];\n        const q = questions[realIdx];\n        if (q && optionIdx < q.choices.length) {\n          const choiceText = q.choices[optionIdx];\n          userAnswers[q.id] = choiceText;\n          localStorage.setItem(LS_KEY_ANSWERS, JSON.stringify(userAnswers));\n          renderActiveQuestion();\n          renderProgress();\n          renderNavigator();\n        }\n      }\n    });\n\n    // Navigation buttons binding\n    document.getElementById(\'prev-btn\').onclick = () => {\n      if (currentIdx > 0) {\n        currentIdx--;\n        saveIndexState();\n        renderActiveQuestion();\n        renderNavigator();\n      }\n    };\n\n    document.getElementById(\'next-btn\').onclick = () => {\n      if (currentIdx < originalIndicesMap.length - 1) {\n        currentIdx++;\n        saveIndexState();\n        renderActiveQuestion();\n        renderNavigator();\n      }\n    };\n\n    // Search query listener\n    document.getElementById(\'search-input\').oninput = () => {\n      renderNavigator();\n    };\n\n    // Submission logic triggers modal\n    document.getElementById(\'submit-test-btn\').onclick = () => {\n      isGraded = true;\n      localStorage.setItem(LS_KEY_GRADED, \"true\");\n\n      // Calculate final correct score\n      let correctCount = 0;\n      questions.forEach(q => {\n        if (userAnswers[q.id] === q.correctAnswer) {\n          correctCount++;\n        }\n      });\n\n      const total = questions.length;\n      const pct = Math.round((correctCount / total) * 100);\n\n      // Render results details\n      document.getElementById(\'results-percentage\').innerText = `${pct}%`;\n      document.getElementById(\'results-fraction\').innerText = `${correctCount} / ${total} Correct`;\n      document.getElementById(\'results-attempted\').innerText = `${Object.keys(userAnswers).length} of ${total} Questions`;\n\n      // Draw SVG Circle indicator\n      const circle = document.getElementById(\'circle-progress\');\n      const offset = 251.2 - (251.2 * pct) / 100;\n      circle.style.strokeDashoffset = offset;\n\n      // Status pill color\n      const statusPill = document.getElementById(\'results-feedback-pill\');\n      if (pct >= 70) {\n        statusPill.className = \"px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider mt-2 bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300\";\n        statusPill.innerText = \"Mastery Level: PASS\";\n        document.getElementById(\'status-badge\').className = \"text-emerald-600 dark:text-emerald-400 text-sm font-semibold\";\n        document.getElementById(\'status-badge\').innerText = \"Exam Passed (Master)\";\n      } else {\n        statusPill.className = \"px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider mt-2 bg-rose-100 text-rose-800 dark:bg-rose-950/50 dark:text-rose-300\";\n        statusPill.innerText = \"Mastery Level: FAIL (Below 70%)\";\n        document.getElementById(\'status-badge\').className = \"text-rose-600 dark:text-rose-400 text-sm font-semibold\";\n        document.getElementById(\'status-badge\').innerText = \"Review Recommended\";\n      }\n\n      // Show Results Modal\n      document.getElementById(\'results-modal\').classList.remove(\'hidden\');\n\n      revealGradedStates();\n      renderActiveQuestion();\n      renderNavigator();\n    };\n\n    // Helper reveals correct/incorrect legend colors\n    function revealGradedStates() {\n      document.querySelectorAll(\'.post-submit-only\').forEach(el => el.classList.remove(\'hidden\'));\n    }\n\n    // Close results summary\n    function dismissResults() {\n      document.getElementById(\'results-modal\').classList.add(\'hidden\');\n    }\n\n    // Retake / reset trigger from modal\n    function retakeExam() {\n      dismissResults();\n      confirmReset();\n    }\n\n    // Click shortcuts key button\n    document.getElementById(\'help-toggle\').onclick = () => {\n      toggleShortcutsHelper();\n    };\n\n    // Boot App\n    window.onload = init;\n  </script>\n</body>\n</html>\n"
    }
