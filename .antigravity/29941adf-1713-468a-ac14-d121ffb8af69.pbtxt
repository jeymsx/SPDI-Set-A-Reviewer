        replacement_content: "      <!-- SIDEBAR SETTINGS & QUESTION NAVIGATOR (4 COLS) -->\n      <div class=\"lg:col-span-4 space-y-6\">\n        \n        <!-- TIMER SIDEBAR CARD -->\n        <div id=\"sidebar-timer-card\" class=\"hidden bg-white dark:bg-[#1e293b] rounded-xl p-5 border border-[#e2e8f0] dark:border-[#334155] shadow-sm space-y-3 relative overflow-hidden\">\n          <div class=\"absolute right-0 top-0 w-20 h-20 bg-[#2563eb]/5 rounded-full blur-xl\"></div>\n          <div class=\"flex items-center justify-between relative z-10\">\n            <h3 class=\"font-bold text-[#1e293b] dark:text-white text-xs uppercase tracking-wider flex items-center space-x-2\">\n              <i data-lucide=\"clock\" class=\"w-4 h-4 text-[#2563eb] dark:text-[#3b82f6]\"></i>\n              <span>Time Remaining</span>\n            </h3>\n            <span id=\"timer-status-badge\" class=\"text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 border border-emerald-100 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-900/30 font-black tracking-wide\">ACTIVE</span>\n          </div>\n          <div class=\"text-3xl font-black font-mono tracking-tight text-[#1e293b] dark:text-white text-center py-2 relative z-10\" id=\"sidebar-timer-text\">\n            00:00:00\n          </div>\n          <div class=\"h-2 w-full bg-[#e2e8f0] dark:bg-[#334155] rounded-full overflow-hidden relative z-10\">\n            <div id=\"timer-progress-bar\" class=\"h-full bg-[#2563eb] rounded-full transition-all duration-300\" style=\"width: 100%\"></div>\n          </div>\n        </div>\n        \n        <!-- EXAM CONTROLS CARD -->"
