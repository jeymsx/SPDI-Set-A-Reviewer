        lines {
          text: "    function buildIndicesMap() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const size = questions.length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
