      target_content: "  <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">"
      replacement_content: "  <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n    <!-- START SCREEN -->\n    <div id=\"start-screen\" class=\"max-w-3xl mx-auto bg-white dark:bg-[#1e293b] rounded-xl p-8 border border-[#e2e8f0] dark:border-[#334155] shadow-lg space-y-8 relative overflow-hidden transition-all duration-300\">\n      <div class=\"absolute right-0 top-0 w-32 h-32 bg-[#2563eb]/10 rounded-full blur-2xl\"></div>\n      \n      <div class=\"text-center space-y-3\">\n        <div class=\"inline-flex p-4 bg-[#eff6ff] dark:bg-[#2563eb]/10 rounded-full text-[#2563eb] dark:text-[#3b82f6]\">\n          <i data-lucide=\"award\" class=\"w-12 h-12\"></i>\n        </div>\n        <h2 class=\"text-3xl font-black text-[#1e293b] dark:text-white tracking-tight\">Ready to Begin Your Master\'s Mastery?</h2>\n        <p class=\"text-sm text-[#64748b] dark:text-[#94a3b8] max-w-lg mx-auto leading-relaxed\">\n          Prepare for the SPDI Set A practice exam. Test your sanitary system designs, water supply logic, and plumbing regulation mastery under timed or self-paced conditions.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div class=\"p-4 bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] rounded-xl text-center space-y-1\">\n          <span class=\"text-xs text-[#64748b] dark:text-[#94a3b8] font-semibold block\">Total Questions</span>\n          <span id=\"start-total-questions\" class=\"text-[#2563eb] dark:text-[#3b82f6] text-2xl font-extrabold block\">76 Questions</span>\n          <span class=\"text-[10px] text-[#64748b] dark:text-[#94a3b8] font-medium\">1 point per item</span>\n        </div>\n        <div class=\"p-4 bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] rounded-xl text-center space-y-1\">\n          <span class=\"text-xs text-[#64748b] dark:text-[#94a3b8] font-semibold block\">Passing Threshold</span>\n          <span class=\"text-emerald-600 dark:text-emerald-400 text-2xl font-extrabold block\">70%</span>\n          <span class=\"text-[10px] text-[#64748b] dark:text-[#94a3b8] font-medium\">54 correct answers minimum</span>\n        </div>\n        <div class=\"p-4 bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] rounded-xl text-center space-y-1\">\n          <span class=\"text-xs text-[#64748b] dark:text-[#94a3b8] font-semibold block\">Configure Timer</span>\n          <div class=\"flex items-center justify-center space-x-1.5 mt-1\">\n            <select id=\"start-duration-select\" class=\"text-sm font-extrabold bg-white dark:bg-[#1e293b] border border-[#e2e8f0] dark:border-[#334155] rounded px-2 py-1 text-[#2563eb] dark:text-[#3b82f6] focus:outline-none focus:border-[#2563eb] cursor-pointer\">\n              <option value=\"30\">30 Min</option>\n              <option value=\"60\">60 Min</option>\n              <option value=\"90\" selected>90 Min</option>\n              <option value=\"120\">120 Min</option>\n              <option value=\"180\">180 Min</option>\n              <option value=\"0\">Unlimited</option>\n            </select>\n          </div>\n          <span class=\"text-[10px] text-[#64748b] dark:text-[#94a3b8] font-medium\">Set duration before starting</span>\n        </div>\n      </div>\n\n      <div class=\"bg-[#eff6ff] dark:bg-[#2563eb]/5 border border-[#dbeafe] dark:border-[#2563eb]/10 p-4 rounded-xl flex items-start space-x-3 text-xs text-[#2563eb] dark:text-[#60a5fa]\">\n        <i data-lucide=\"info\" class=\"w-5 h-5 shrink-0 mt-0.5\"></i>\n        <div class=\"space-y-1 font-medium leading-relaxed text-left\">\n          <p class=\"font-bold text-[#2563eb] dark:text-[#3b82f6]\">Instructions & Rules:</p>\n          <ul class=\"list-disc pl-4 space-y-1\">\n            <li>You can navigate back and forth between questions at any time.</li>\n            <li>Your answers are auto-saved in your browser\'s local cache.</li>\n            <li>If you choose a timed exam, the countdown starts as soon as you press Start. If time runs out, your exam is automatically submitted for grading.</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"flex flex-col sm:flex-row items-center justify-between pt-4 border-t border-[#e2e8f0] dark:border-[#334155] gap-4\">\n        <div>\n          <button id=\"start-clear-btn\" type=\"button\" class=\"text-xs font-semibold text-rose-500 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/20 px-3 py-2 rounded-md transition-all cursor-pointer flex items-center space-x-1.5 border border-transparent hover:border-rose-200\">\n            <i data-lucide=\"trash-2\" class=\"w-4 h-4\"></i>\n            <span id=\"start-clear-text\">Reset Saved Progress & Clear Cache</span>\n          </button>\n        </div>\n        <button id=\"start-exam-btn\" type=\"button\" class=\"w-full sm:w-auto px-8 py-4 bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-black text-base rounded-xl shadow-lg shadow-blue-500/20 hover:shadow-blue-500/35 transition-all cursor-pointer flex items-center justify-center space-x-2\">\n          <span>Start Exam</span>\n          <i data-lucide=\"play\" class=\"w-5 h-5\"></i>\n        </button>\n      </div>\n    </div>\n\n    <!-- ACTIVE WORKSPACE -->\n    <div id=\"exam-workspace\" class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 hidden\">"
    }
