    replacement_chunks {
      target_content: "    }\n\n    // Map logic mapping virtual indices (what user is viewing) to real data indices"
      replacement_content: "    }\n\n    // Start the exam with a specified duration in minutes\n    function startExam(durationMinutes) {\n      examStarted = true;\n      timerDuration = durationMinutes;\n      localStorage.setItem(LS_KEY_EXAM_STARTED, \"true\");\n      localStorage.setItem(LS_KEY_TIMER_DURATION, durationMinutes.toString());\n\n      if (durationMinutes > 0) {\n        timerEndTime = Date.now() + durationMinutes * 60 * 1000;\n        localStorage.setItem(LS_KEY_TIMER_END_TIME, timerEndTime.toString());\n        startTimerTicker();\n      } else {\n        localStorage.removeItem(LS_KEY_TIMER_END_TIME);\n        hideTimerUI();\n      }\n\n      // Smooth switch of screen visibility\n      document.getElementById(\'start-screen\').classList.add(\'hidden\');\n      document.getElementById(\'exam-workspace\').classList.remove(\'hidden\');\n\n      // Refresh Lucide icons in workspace\n      lucide.createIcons();\n\n      // Ensure active question and progress are correctly set up\n      renderProgress();\n      renderActiveQuestion();\n      renderNavigator();\n    }\n\n    // Reset all progress and clear localStorage on the start screen\n    function clearAllProgress() {\n      // Clear storage\n      localStorage.removeItem(LS_KEY_ANSWERS);\n      localStorage.removeItem(LS_KEY_IDX);\n      localStorage.removeItem(LS_KEY_GRADED);\n      localStorage.removeItem(LS_KEY_EXAM_STARTED);\n      localStorage.removeItem(LS_KEY_TIMER_DURATION);\n      localStorage.removeItem(LS_KEY_TIMER_END_TIME);\n      localStorage.removeItem(\"spdi_shuffled_pool_indices\");\n\n      // Reset state variables\n      userAnswers = {};\n      isGraded = false;\n      currentIdx = 0;\n      examStarted = false;\n      timerEndTime = 0;\n      shuffledChoicesPool = {};\n\n      if (timerInterval) {\n        clearInterval(timerInterval);\n        timerInterval = null;\n      }\n\n      // Hide post-submit legends\n      document.querySelectorAll(\'.post-submit-only\').forEach(el => el.classList.add(\'hidden\'));\n\n      // Rebuild initial state\n      buildIndicesMap();\n      renderProgress();\n      renderActiveQuestion();\n      renderNavigator();\n\n      // Show friendly message on the clear button\n      const clearBtnText = document.getElementById(\'start-clear-text\');\n      const originalText = clearBtnText.innerText;\n      clearBtnText.innerText = \"Progress Reset & Cache Cleared!\";\n      setTimeout(() => {\n        clearBtnText.innerText = originalText;\n      }, 2500);\n    }\n\n    // Timer ticker updates remaining time and visual indicators\n    function startTimerTicker() {\n      if (timerInterval) {\n        clearInterval(timerInterval);\n      }\n\n      const hTimerContainer = document.getElementById(\'header-timer-container\');\n      const sTimerCard = document.getElementById(\'sidebar-timer-card\');\n\n      hTimerContainer.classList.remove(\'hidden\');\n      sTimerCard.classList.remove(\'hidden\');\n\n      function updateTicker() {\n        const now = Date.now();\n        const timeLeft = timerEndTime - now;\n\n        if (timeLeft <= 0) {\n          clearInterval(timerInterval);\n          timerInterval = null;\n          \n          document.getElementById(\'header-timer-text\').innerText = \"00:00:00\";\n          document.getElementById(\'sidebar-timer-text\').innerText = \"00:00:00\";\n          document.getElementById(\'timer-progress-bar\').style.width = \"0%\";\n          \n          // Submit the exam automatically\n          autoSubmitExam();\n          return;\n        }\n\n        // Format duration\n        const totalSeconds = Math.floor(timeLeft / 1000);\n        const hours = Math.floor(totalSeconds / 3600);\n        const minutes = Math.floor((totalSeconds % 3600) / 60);\n        const seconds = totalSeconds % 60;\n\n        const formattedTime = [\n          hours.toString().padStart(2, \'0\'),\n          minutes.toString().padStart(2, \'0\'),\n          seconds.toString().padStart(2, \'0\')\n        ].join(\':\');\n\n        document.getElementById(\'header-timer-text\').innerText = formattedTime;\n        document.getElementById(\'sidebar-timer-text\').innerText = formattedTime;\n\n        // Progress bar percentage\n        const totalTimeMs = timerDuration * 60 * 1000;\n        const pct = Math.min(100, Math.max(0, (timeLeft / totalTimeMs) * 100));\n        const progressBar = document.getElementById(\'timer-progress-bar\');\n        progressBar.style.width = `${pct}%`;\n\n        // Urgent styling logic\n        const badge = document.getElementById(\'timer-status-badge\');\n        if (timeLeft < 60000) {\n          // Less than 1 minute: Red & fast flashing\n          progressBar.className = \"h-full bg-rose-500 animate-pulse rounded-full transition-all duration-300\";\n          hTimerContainer.className = \"flex items-center space-x-2 bg-rose-100 border border-rose-200 px-3 py-1.5 rounded-lg text-xs font-black text-rose-600 animate-pulse dark:bg-rose-950/20 dark:border-rose-900/30\";\n          badge.innerText = \"CRITICAL\";\n          badge.className = \"text-[10px] px-2 py-0.5 rounded bg-rose-100 text-rose-600 border border-rose-200 dark:bg-rose-950/40 dark:text-rose-400 dark:border-rose-900/30 font-black tracking-wide animate-pulse\";\n        } else if (timeLeft < 300000) {\n          // Less than 5 minutes: Amber warning\n          progressBar.className = \"h-full bg-amber-500 rounded-full transition-all duration-300\";\n          hTimerContainer.className = \"flex items-center space-x-2 bg-amber-100 border border-amber-200 px-3 py-1.5 rounded-lg text-xs font-bold text-amber-600 dark:bg-amber-950/20 dark:border-amber-900/30\";\n          badge.innerText = \"WARNING\";\n          badge.className = \"text-[10px] px-2 py-0.5 rounded bg-amber-100 text-amber-600 border border-amber-200 dark:bg-amber-950/40 dark:text-amber-400 dark:border-amber-900/30 font-black tracking-wide\";\n        } else {\n          // Normal colors\n          progressBar.className = \"h-full bg-[#2563eb] rounded-full transition-all duration-300\";\n          hTimerContainer.className = \"flex items-center space-x-2 bg-[#eff6ff] dark:bg-[#2563eb]/10 border border-[#dbeafe] dark:border-[#2563eb]/20 px-3 py-1.5 rounded-lg text-xs font-bold text-[#2563eb] dark:text-[#3b82f6]\";\n          badge.innerText = \"ACTIVE\";\n          badge.className = \"text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 border border-emerald-100 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-900/30 font-black tracking-wide\";\n        }\n      }\n\n      updateTicker();\n      timerInterval = setInterval(updateTicker, 1000);\n    }\n\n    // Stop and clean up timer interval\n    function stopTimerTicker() {\n      if (timerInterval) {\n        clearInterval(timerInterval);\n        timerInterval = null;\n      }\n    }\n\n    // Hide timer containers\n    function hideTimerUI() {\n      document.getElementById(\'header-timer-container\').classList.add(\'hidden\');\n      document.getElementById(\'sidebar-timer-card\').classList.add(\'hidden\');\n    }\n\n    // Show persistent completed / static state of the timer\n    function showTimerCompletedState() {\n      stopTimerTicker();\n      \n      const hTimerContainer = document.getElementById(\'header-timer-container\');\n      const sTimerCard = document.getElementById(\'sidebar-timer-card\');\n      \n      hTimerContainer.classList.add(\'hidden\');\n      sTimerCard.classList.remove(\'hidden\');\n      \n      document.getElementById(\'sidebar-timer-text\').innerText = \"SUBMITTED\";\n      document.getElementById(\'timer-progress-bar\').style.width = \"100%\";\n      document.getElementById(\'timer-progress-bar\').className = \"h-full bg-emerald-500 rounded-full\";\n      \n      const badge = document.getElementById(\'timer-status-badge\');\n      badge.innerText = \"GRADED\";\n      badge.className = \"text-[10px] px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-400 dark:border-emerald-900/30 font-black tracking-wide\";\n    }\n\n    // Submits the exam automatically when timer reaches zero\n    function autoSubmitExam() {\n      // Show the expired banner on Results modal\n      document.getElementById(\'time-expired-banner\').classList.remove(\'hidden\');\n      \n      // Fire the normal submission click logic\n      document.getElementById(\'submit-test-btn\').click();\n    }\n\n    // Map logic mapping virtual indices (what user is viewing) to real data indices"
    }
