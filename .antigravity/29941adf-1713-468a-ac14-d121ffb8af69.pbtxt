      target_content: "        <!-- EXAM DESCRIPTIVE CARD (COLLAPSIBLE / PERSISTED DISMISSED) -->\n        <div id=\"welcome-card\" class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm relative overflow-hidden\">\n          <div class=\"absolute right-0 top-0 w-24 h-24 bg-indigo-500/10 rounded-full blur-xl\"></div>\n          <button onclick=\"dismissWelcome()\" class=\"absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200\">\n            <i data-lucide=\"x\" class=\"w-5 h-5\"></i>\n          </button>\n          <h2 class=\"text-xl font-bold text-slate-900 dark:text-white mb-2\">Master\'s Mastery Test: SPDI Set A</h2>\n          <p class=\"text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4\">\n            This comprehensive practice exam consists of 76 specialized multiple-choice questions focusing on sanitary systems, water supply piping, fire protection sprinklers, and plumbing regulations.\n          </p>\n          <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-semibold\">\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Passing Grade</span>\n              <span class=\"text-indigo-600 dark:text-indigo-400 text-sm\">70% (54 / 76)</span>\n            </div>\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Total Items</span>\n              <span id=\"items-count\" class=\"text-indigo-600 dark:text-indigo-400 text-sm\">76 Questions</span>\n            </div>\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Study Modes</span>\n              <span class=\"text-indigo-600 dark:text-indigo-400 text-sm\">Shuffle & Targeted Review</span>\n            </div>\n            <div class=\"p-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl\">\n              <span class=\"text-slate-400 dark:text-slate-500 block mb-1\">Status</span>\n              <span id=\"status-badge\" class=\"text-amber-600 dark:text-amber-400 text-sm\">Practice Active</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- PROGRESS BAR -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-100 dark:border-slate-800 shadow-sm\">\n          <div class=\"flex items-center justify-between text-xs font-semibold mb-2\">\n            <div class=\"flex items-center space-x-2 text-indigo-600 dark:text-indigo-400\">\n              <i data-lucide=\"check-circle\" class=\"w-4 h-4\"></i>\n              <span id=\"answered-indicator\">0 of 76 Answered</span>\n            </div>\n            <span id=\"progress-percentage-text\" class=\"text-slate-500 dark:text-slate-400\">0% Done</span>\n          </div>\n          <div class=\"h-2 w-full bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden\">\n            <div id=\"progress-fill\" class=\"h-full bg-indigo-500 rounded-full transition-all duration-300\" style=\"width: 0%\"></div>\n          </div>\n        </div>\n\n        <!-- MAIN QUESTION CARD -->\n        <div id=\"question-card\" class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 sm:p-8 border border-slate-100 dark:border-slate-800 shadow-sm space-y-6 transition-all duration-200\">\n          \n          <!-- Question Header -->\n          <div class=\"flex items-center justify-between\">\n            <span id=\"question-index-label\" class=\"text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 px-3 py-1.5 rounded-full\">\n              Question 1 of 76\n            </span>\n            <div class=\"flex items-center space-x-1.5\">\n              <span id=\"question-points\" class=\"text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-900 px-2.5 py-1.5 rounded-md\">\n                1 Point\n              </span>\n            </div>\n          </div>\n\n          <!-- Question Body -->\n          <div>\n            <h3 id=\"question-text\" class=\"text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-relaxed\">\n              Loading Question...\n            </h3>\n          </div>\n\n          <!-- OPTIONAL MEDIA PREVIEW -->\n          <div id=\"question-media-container\" class=\"hidden flex justify-center bg-slate-50 dark:bg-slate-900 p-4 rounded-xl border border-slate-100 dark:border-slate-800\">\n            <img id=\"question-image\" src=\"\" alt=\"Question Attachment\" class=\"max-h-72 object-contain rounded shadow-sm\">\n          </div>\n\n          <!-- ANSWER CHOICES CONTAINER -->\n          <div id=\"choices-container\" class=\"grid grid-cols-1 gap-3.5\">\n            <!-- Choices injected dynamically -->\n          </div>\n\n          <!-- SUBMIT FEEDBACK (Shown after submission) -->\n          <div id=\"answer-feedback\" class=\"hidden p-4 rounded-xl border flex items-start space-x-3\">\n            <div id=\"feedback-icon-container\" class=\"p-1 rounded-full text-white mt-0.5\">\n              <!-- Icon dynamically selected -->\n            </div>\n            <div>\n              <h4 id=\"feedback-title\" class=\"font-bold text-sm\">Correct</h4>\n              <p id=\"feedback-desc\" class=\"text-xs text-slate-600 dark:text-slate-300 mt-0.5\"></p>\n            </div>\n          </div>\n        </div>\n\n        <!-- NAVIGATION CONTROLS -->\n        <div class=\"flex items-center justify-between\">\n          <button id=\"prev-btn\" class=\"px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 font-bold text-sm flex items-center space-x-2 transition-colors\">\n            <i data-lucide=\"chevron-left\" class=\"w-4 h-4\"></i>\n            <span>Previous</span>\n          </button>\n          \n          <button id=\"next-btn\" class=\"px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 font-bold text-sm flex items-center space-x-2 transition-colors\">\n            <span>Next</span>\n            <i data-lucide=\"chevron-right\" class=\"w-4 h-4\"></i>\n          </button>\n        </div>"
      replacement_content: "        <!-- EXAM DESCRIPTIVE CARD (COLLAPSIBLE / PERSISTED DISMISSED) -->\n        <div id=\"welcome-card\" class=\"bg-white dark:bg-[#1e293b] rounded-xl p-6 border border-[#e2e8f0] dark:border-[#334155] shadow-sm relative overflow-hidden\">\n          <div class=\"absolute right-0 top-0 w-24 h-24 bg-[#2563eb]/10 rounded-full blur-xl\"></div>\n          <button onclick=\"dismissWelcome()\" class=\"absolute top-4 right-4 text-[#64748b] hover:text-[#1e293b] dark:hover:text-[#f1f5f9]\">\n            <i data-lucide=\"x\" class=\"w-5 h-5\"></i>\n          </button>\n          <h2 class=\"text-xl font-bold text-[#1e293b] dark:text-white mb-2\">Master\'s Mastery Test: SPDI Set A</h2>\n          <p class=\"text-sm text-[#64748b] dark:text-[#94a3b8] leading-relaxed mb-4\">\n            This comprehensive practice exam consists of 76 specialized multiple-choice questions focusing on sanitary systems, water supply piping, fire protection sprinklers, and plumbing regulations.\n          </p>\n          <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-semibold\">\n            <div class=\"p-3 bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] rounded-md\">\n              <span class=\"text-[#64748b] dark:text-[#94a3b8] block mb-1\">Passing Grade</span>\n              <span class=\"text-[#2563eb] dark:text-[#3b82f6] text-sm\">70% (54 / 76)</span>\n            </div>\n            <div class=\"p-3 bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] rounded-md\">\n              <span class=\"text-[#64748b] dark:text-[#94a3b8] block mb-1\">Total Items</span>\n              <span id=\"items-count\" class=\"text-[#2563eb] dark:text-[#3b82f6] text-sm\">76 Questions</span>\n            </div>\n            <div class=\"p-3 bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] rounded-md\">\n              <span class=\"text-[#64748b] dark:text-[#94a3b8] block mb-1\">Study Modes</span>\n              <span class=\"text-[#2563eb] dark:text-[#3b82f6] text-sm\">Shuffle & Targeted Review</span>\n            </div>\n            <div class=\"p-3 bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] rounded-md\">\n              <span class=\"text-[#64748b] dark:text-[#94a3b8] block mb-1\">Status</span>\n              <span id=\"status-badge\" class=\"text-amber-600 dark:text-amber-400 text-sm\">Practice Active</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- PROGRESS BAR -->\n        <div class=\"bg-white dark:bg-[#1e293b] rounded-xl p-4 border border-[#e2e8f0] dark:border-[#334155] shadow-sm\">\n          <div class=\"flex items-center justify-between text-xs font-semibold mb-2\">\n            <div class=\"flex items-center space-x-2 text-[#2563eb] dark:text-[#3b82f6]\">\n              <i data-lucide=\"check-circle\" class=\"w-4 h-4\"></i>\n              <span id=\"answered-indicator\">0 of 76 Answered</span>\n            </div>\n            <span id=\"progress-percentage-text\" class=\"text-[#64748b] dark:text-[#94a3b8]\">0% Done</span>\n          </div>\n          <div class=\"h-2 w-full bg-[#e2e8f0] dark:bg-[#334155] rounded-full overflow-hidden\">\n            <div id=\"progress-fill\" class=\"h-full bg-[#2563eb] rounded-full transition-all duration-300\" style=\"width: 0%\"></div>\n          </div>\n        </div>\n\n        <!-- MAIN QUESTION CARD -->\n        <div id=\"question-card\" class=\"bg-white dark:bg-[#1e293b] rounded-xl p-6 sm:p-8 border border-[#e2e8f0] dark:border-[#334155] shadow-sm space-y-6 transition-all duration-200\">\n          \n          <!-- Question Header -->\n          <div class=\"flex items-center justify-between\">\n            <span id=\"question-index-label\" class=\"text-xs font-bold uppercase tracking-wider text-[#2563eb] dark:text-[#3b82f6] bg-[#eff6ff] dark:bg-[#2563eb]/10 px-3 py-1.5 rounded-md\">\n              Question 1 of 76\n            </span>\n            <div class=\"flex items-center space-x-1.5\">\n              <span id=\"question-points\" class=\"text-xs font-medium text-[#64748b] dark:text-[#94a3b8] bg-[#f8fafc] dark:bg-[#0f172a] border border-[#e2e8f0] dark:border-[#334155] px-2.5 py-1.5 rounded-md\">\n                1 Point\n              </span>\n            </div>\n          </div>\n\n          <!-- Question Body -->\n          <div>\n            <h3 id=\"question-text\" class=\"text-lg sm:text-xl font-bold text-[#1e293b] dark:text-white leading-relaxed\">\n              Loading Question...\n            </h3>\n          </div>\n\n          <!-- OPTIONAL MEDIA PREVIEW -->\n          <div id=\"question-media-container\" class=\"hidden flex justify-center bg-[#f8fafc] dark:bg-[#0f172a] p-4 rounded-xl border border-[#e2e8f0] dark:border-[#334155]\">\n            <img id=\"question-image\" src=\"\" alt=\"Question Attachment\" class=\"max-h-72 object-contain rounded shadow-sm\">\n          </div>\n\n          <!-- ANSWER CHOICES CONTAINER -->\n          <div id=\"choices-container\" class=\"grid grid-cols-1 gap-3.5\">\n            <!-- Choices injected dynamically -->\n          </div>\n\n          <!-- SUBMIT FEEDBACK (Shown after submission) -->\n          <div id=\"answer-feedback\" class=\"hidden p-4 rounded-xl border flex items-start space-x-3\">\n            <div id=\"feedback-icon-container\" class=\"p-1 rounded-full text-white mt-0.5\">\n              <!-- Icon dynamically selected -->\n            </div>\n            <div>\n              <h4 id=\"feedback-title\" class=\"font-bold text-sm\">Correct</h4>\n              <p id=\"feedback-desc\" class=\"text-xs text-slate-600 dark:text-slate-300 mt-0.5\"></p>\n            </div>\n          </div>\n        </div>\n\n        <!-- NAVIGATION CONTROLS -->\n        <div class=\"flex items-center justify-between\">\n          <button id=\"prev-btn\" class=\"px-5 py-2.5 rounded-md border border-[#e2e8f0] dark:border-[#334155] bg-white dark:bg-[#1e293b] hover:bg-[#f8fafc] dark:hover:bg-[#0f172a] text-[#1e293b] dark:text-[#f1f5f9] font-semibold text-sm flex items-center space-x-2 transition-all cursor-pointer\">\n            <i data-lucide=\"chevron-left\" class=\"w-4 h-4\"></i>\n            <span>Previous</span>\n          </button>\n          \n          <button id=\"next-btn\" class=\"px-5 py-2.5 rounded-md bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold text-sm flex items-center space-x-2 transition-all cursor-pointer\">\n            <span>Next</span>\n            <i data-lucide=\"chevron-right\" class=\"w-4 h-4\"></i>\n          </button>\n        </div>"
    }
