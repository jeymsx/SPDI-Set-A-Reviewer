  file_change {
    absolute_path_uri: "file:///src/questions.js"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "window.questionsData = [\n  {\n    id: 1,\n    question: \"Service weight cast iron is abbreviated as __________.\",\n    choices: [\"SW\", \"SV\", \"XH\", \"XW\"],\n    correctAnswer: \"SV\"\n  },\n  {\n    id: 2,\n    question: \"The combinations of fittings that may be used to make an offset.\",\n    choices: [\n      \"1 \342\200\223 90 degree and 1 \342\200\223 45 degree\",\n      \"2 \342\200\223 90 degree and 1 \342\200\223 45 degree\",\n      \"1 \342\200\223 45 degree and 1 \342\200\223 45 degree\",\n      \"1 \342\200\223 45 degree and 1 \342\200\223 60 degree\"\n    ],\n    correctAnswer: \"1 \342\200\223 45 degree and 1 \342\200\223 45 degree\"\n  },\n  {\n    id: 3,\n    question: \"A nipple longer than a close nipple and includes a very short unthreaded space between the threads.\",\n    choices: [\"Shoulder Nipple\", \"Long Nipple\", \"Cut Pipe\", \"Reducing Nipple\"],\n    correctAnswer: \"Shoulder Nipple\"\n  },\n  {\n    id: 4,\n    question: \"This refers to the formation of mounds of reddish-brown iron-oxide on the interior of a pipe, which increases roughness and resistance to water flow.\",\n    choices: [\"Corrosion\", \"Tuberculation\", \"Carbonation\", \"Pitting\"],\n    correctAnswer: \"Tuberculation\"\n  },\n  {\n    id: 5,\n    question: \"Also known as Transite Pipe.\",\n    choices: [\"Asbestos Cement Pipe\", \"Concrete Sewer Pipe\", \"Brass Pipe\", \"Wrought Iron Pipe\"],\n    correctAnswer: \"Asbestos Cement Pipe\"\n  },\n  {\n    id: 6,\n    question: \"When connecting an ejector pump to a horizontal drainline, in what order should the following components be installed?\",\n    choices: [\n      \"Gate valve \342\206\222 Check valve \342\206\222 Pump\",\n      \"Pump \342\206\222 Check valve \342\206\222 Gate valve\",\n      \"Check valve \342\206\222 Gate valve \342\206\222 Pump\",\n      \"Pump \342\206\222 Gate valve \342\206\222 Check valve\"\n    ],\n    correctAnswer: \"Pump \342\206\222 Check valve \342\206\222 Gate valve\"\n  },\n  {\n    id: 7,\n    question: \"What type of fire sprinkler system has open sprinkler heads, does not contain water or pressurized air, and activates all at once when a detector senses smoke or heat?\",\n    choices: [\"Pre-action\", \"Deluge\", \"Wet\", \"Dry\"],\n    correctAnswer: \"Deluge\"\n  },\n  {\n    id: 8,\n    question: \"Best location to put soil pipes?\",\n    choices: [\"150 mm CHB wall\", \"200 mm CHB wall\", \"Pipe Chase\", \"Inside Columns\"],\n    correctAnswer: \"Pipe Chase\"\n  },\n  {\n    id: 9,\n    question: \"What is the travel distance of the pipe given an offset length of 70 cm and an offset angle of 45\302\260?\",\n    choices: [\"49.5 cm\", \"70 cm\", \"99 cm\", \"140 cm\"],\n    correctAnswer: \"99 cm\"\n  },\n  {\n    id: 10,\n    question: \"Standard Weight Pipe (STD).\",\n    choices: [\"Schedule 20S\", \"Schedule 40\", \"Schedule 80\", \"Schedule 100\"],\n    correctAnswer: \"Schedule 40\"\n  },\n  {\n    id: 11,\n    question: \"PPR stands for:\",\n    choices: [\n      \"Polypropylene Random Copolymer\",\n      \"Polypropylene Resin Copolymer\",\n      \"Polypropylene Render Copolymer\",\n      \"Polypropylene Reinforced Copolymer\"\n    ],\n    correctAnswer: \"Polypropylene Random Copolymer\"\n  },\n  {\n    id: 12,\n    question: \"A pipe or shaft which conveys foul air from a plumbing fixture or a room to the outer air.\",\n    choices: [\"Flue\", \"Local Vent\", \"Pipe Chase\", \"Exhaust\"],\n    correctAnswer: \"Local Vent\"\n  },\n  {\n    id: 13,\n    question: \"A non-combustible packing material, usually an asbestos rope, generally used as guide and holds molten lead in a bell during the pouring.\",\n    choices: [\"Lead Guide\", \"Oakum\", \"Joint Runner\", \"Caulk Joint\"],\n    correctAnswer: \"Joint Runner\"\n  },\n  {\n    id: 14,\n    question: \"Scrub sinks are usually found in?\",\n    choices: [\"Shopping Malls\", \"Factories\", \"Hospitals\", \"Restaurants\"],\n    correctAnswer: \"Hospitals\"\n  },\n  {\n    id: 15,\n    question: \"A type of stainless steel used for general corrosive service, containing 18% chromium and 8% nickel.\",\n    choices: [\"Duplex\", \"Martensitic\", \"Austenitic\", \"Ferritic\"],\n    correctAnswer: \"Austenitic\"\n  },\n  {\n    id: 16,\n    question: \"Ozone is commonly used as a disinfectant as it instantly neutralizes biological matter, such as bacteria, viruses, and parasites. What is the chemical formula for ozone?\",\n    choices: [\"O(OH)\342\202\202\", \"O\342\202\203\", \"SO\342\202\202\", \"CH\342\202\204\"],\n    correctAnswer: \"O\342\202\203\"\n  },\n  {\n    id: 17,\n    question: \"A pump that operates on the principle of a high-pressure fluid stream and the Venturi effect. It is typically used for drawing water up from a well.\",\n    choices: [\"Booster Pump\", \"Centrifugal Pump\", \"Jockey Pump\", \"Jet Pump\"],\n    correctAnswer: \"Jet Pump\"\n  },\n  {\n    id: 18,\n    question: \"How do you connect PPR pipes?\",\n    choices: [\"flaring\", \"threaded connection\", \"fusion welding\", \"solvent cement\"],\n    correctAnswer: \"fusion welding\"\n  },\n  {\n    id: 19,\n    question: \"These pipes are derived from solid cylindrical steel known as billets which are heated and cast over a form such as a piercing mandrel to create a hollow tube or shell.\",\n    choices: [\"Seamless Pipes\", \"Galvanized Steel Pipes\", \"Pig Iron Pipes\", \"Wrought Iron Pipes\"],\n    correctAnswer: \"Seamless Pipes\"\n  },\n  {\n    id: 20,\n    question: \"It is a fitting that connects a number of branches to the main. It serves as a distribution point.\",\n    choices: [\"Header\", \"Access Junction\", \"Manifold\", \"Home Run\"],\n    correctAnswer: \"Manifold\"\n  },\n  {\n    id: 21,\n    question: \"A well excavated in the confined aquifer wherein the water rises in the well casing above the land surface naturally without using a pump.\",\n    choices: [\"Jetted Well\", \"Dug Well\", \"Shallow Well\", \"Flowing Artesian Well\"],\n    correctAnswer: \"Flowing Artesian Well\"\n  },\n  {\n    id: 22,\n    question: \"Where is the terminus of a loop vent connected to?\",\n    choices: [\"Stack Vent\", \"Vent Stack\", \"Waste Stack\", \"Waste Vent\"],\n    correctAnswer: \"Stack Vent\"\n  },\n  {\n    id: 23,\n    question: \"A substance with pH of 3 is considered:\",\n    choices: [\"Acidic\", \"Neutral\", \"Alkaline\", \"Non-corrosive\"],\n    correctAnswer: \"Acidic\"\n  },\n  {\n    id: 24,\n    question: \"The minimum detention time for suspended matters in a septic tank to settle and stabilize.\",\n    choices: [\"24 hours\", \"36 hours\", \"48 hours\", \"72 hours\"],\n    correctAnswer: \"24 hours\"\n  },\n  {\n    id: 25,\n    question: \"Which of the following is a bushing?\",\n    choices: [\"A\", \"B\", \"C\", \"D\"],\n    correctAnswer: \"B\",\n    images: [\n      \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed.jpg\",\n      \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed(1).jpg\",\n      \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed(2).jpg\",\n      \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed(3).jpg\"\n    ]\n  },\n  {\n    id: 26,\n    question: \"It is instrument used to measure humidity, or the amount of water vapor in air, in soil, or other confined space.\",\n    choices: [\"Hygrometer\", \"Manometer\", \"Venturi Meter\", \"Pitot Tube\"],\n    correctAnswer: \"Hygrometer\"\n  },\n  {\n    id: 27,\n    question: \"What air pressure may be substituted for the water test when testing a water piping system?\",\n    choices: [\"34.5 kPa\", \"55.16 kPa\", \"103.42 kPa\", \"344.5 kPa\"],\n    correctAnswer: \"344.5 kPa\"\n  },\n  {\n    id: 28,\n    question: \"Which of these valves is ideal for throttling applications?\",\n    choices: [\"Globe Valve\", \"Gate Valve\", \"Check Valve\", \"Ball Valve\"],\n    correctAnswer: \"Globe Valve\"\n  },\n  {\n    id: 29,\n    question: \"An unobstructed top open edge of a fixture.\",\n    choices: [\"Flood Level\", \"Flood Level Rim\", \"Overflow Rim\", \"Rim\"],\n    correctAnswer: \"Flood Level Rim\"\n  },\n  {\n    id: 30,\n    question: \"Hot water demand for private hotel lavatory.\",\n    choices: [\"1 GPH\", \"2 GPH\", \"2.8 GPH\", \"4 PH\"],\n    correctAnswer: \"2 GPH\"\n  },\n  {\n    id: 31,\n    question: \"The phase transition in which gas transforms into solid without passing through the liquid phase.\",\n    choices: [\"Deposition\", \"Sublimation\", \"Freezing\", \"Crystallization\"],\n    correctAnswer: \"Deposition\"\n  },\n  {\n    id: 32,\n    question: \"A type of fitting for yoke vent.\",\n    choices: [\"Sanitary Tee\", \"Wye fitting\", \"Combination fitting\", \"Long Sweep\"],\n    correctAnswer: \"Wye fitting\"\n  },\n  {\n    id: 33,\n    question: \"Closet bends or stubs must be cut off square so as to present a smooth surface even with the __________.\",\n    choices: [\"top of the closet ring\", \"top of the finish floor\", \"top of the rough floor\", \"bottom of the closet ring\"],\n    correctAnswer: \"top of the closet ring\"\n  },\n  {\n    id: 34,\n    question: \"The measure of the amount of oxygen required to chemically oxidize the organic material and inorganic nutrients present in water.\",\n    choices: [\"Chemical Oxygen Demand\", \"Biological Oxygen Demand\", \"Biochemical Oxygen Demand\", \"Oxygen Demand\"],\n    correctAnswer: \"Chemical Oxygen Demand\"\n  },\n  {\n    id: 35,\n    question: \"It refers to the sinkable solids that settle at the bottom of a septic tank where anaerobic decomposition takes place.\",\n    choices: [\"Scum\", \"Sludge\", \"Residue\", \"Sediment\"],\n    correctAnswer: \"Sludge\"\n  },\n  {\n    id: 36,\n    question: \"A laboratory procedure that simulates coagulation/flocculation in a water treatment plant. It is done to determine the proper coagulant and dose required to achieve certain water quality goals.\",\n    choices: [\"Batch Test\", \"Tube Test\", \"Jar Test\", \"Bottle Test\"],\n    correctAnswer: \"Jar Test\"\n  },\n  {\n    id: 37,\n    question: \"An approved plumbing fixture or device of such materials, shape and capacity that adequately receives the discharge from indirect waste pipes, constructed & located to be readily cleaned.\",\n    choices: [\"Interceptor\", \"Receptor\", \"Catch Basin\", \"Separator\"],\n    correctAnswer: \"Receptor\"\n  },\n  {\n    id: 38,\n    question: \"A fitting with continuous ridges or bumps, used to connect hoses to pipes and maintain a watertight seal.\",\n    choices: [\"Hose Bibb\", \"Sill Cock\", \"Barb\", \"Push-fit Fitting\"],\n    correctAnswer: \"Barb\"\n  },\n  {\n    id: 39,\n    question: \"What is the minimum volume of a water sample required for testing total hardness?\",\n    choices: [\"50 mL\", \"100 mL\", \"500 mL\", \"1 liter\"],\n    correctAnswer: \"100 mL\"\n  },\n  {\n    id: 40,\n    question: \"What is the standard commercial length of a PVC pipe?\",\n    choices: [\"1.5 meters\", \"3 meters\", \"4 meters\", \"6 meters\"],\n    correctAnswer: \"3 meters\"\n  },\n  {\n    id: 41,\n    question: \"A small, usually high pressure, pump used to maintain the designed system pressure in a fire protection system.\",\n    choices: [\"Jockey Pump\", \"Plunger Pump\", \"Piston Pump\", \"Fire Pump\"],\n    correctAnswer: \"Jockey Pump\"\n  },\n  {\n    id: 42,\n    question: \"The measure of the internal friction of a liquid due to its resistance to flow is called:\",\n    choices: [\"Friction Loss\", \"Viscosity\", \"Shear Stress\", \"Surface Tension\"],\n    correctAnswer: \"Viscosity\"\n  },\n  {\n    id: 43,\n    question: \"An assembly consisting of a running trap equipped with a cleanout, installed on the floor of a basement areaway that cannot otherwise be drained.\",\n    choices: [\"Area Drain\", \"Sump\", \"French Drain\", \"Running Trap\"],\n    correctAnswer: \"Area Drain\"\n  },\n  {\n    id: 44,\n    question: \"Brass pipes are manufactured from an alloy containing:\",\n    choices: [\"15% Zinc; 85% Copper\", \"15% Tin; 85% Copper\", \"15% Carbon; 85% Copper\", \"15% Iron; 85% Copper\"],\n    correctAnswer: \"15% Zinc; 85% Copper\"\n  },\n  {\n    id: 45,\n    question: \"A valve used to reduce the incoming pressure of a fluid and maintain safe, consistent pressure levels throughout the system.\",\n    choices: [\"Pressure-Reducing Valve\", \"Pressure-Relief Valve\", \"Pressure-Regulating Valve\", \"Pressure Balancing Valve\"],\n    correctAnswer: \"Pressure-Reducing Valve\"\n  },\n  {\n    id: 46,\n    question: \"A physical property of a material that describes its ability to deform under pressure or hammering without cracking or breaking.\",\n    choices: [\"Ductility\", \"Malleability\", \"Elasticity\", \"Tension\"],\n    correctAnswer: \"Malleability\"\n  },\n  {\n    id: 47,\n    question: \"Soil pipe is commonly listed by standard length requirements, size, the material, and the strength or __________.\",\n    choices: [\"weakness\", \"weight\", \"diameter\", \"composition\"],\n    correctAnswer: \"weight\"\n  },\n  {\n    id: 48,\n    question: \"A measurement of heat equivalent to 100,000 B.T.U.\",\n    choices: [\"Therm\", \"Quad\", \"Ton of Refrigeration\", \"Tesla\"],\n    correctAnswer: \"Therm\"\n  },\n  {\n    id: 49,\n    question: \"WSFU of a bedpan washer.\",\n    choices: [\"4\", \"6\", \"8\", \"10\"],\n    correctAnswer: \"10\"\n  },\n  {\n    id: 50,\n    question: \"Minimum hanger rod size for pipes or tubes 1/2\\\" to 4\\\" in diameter.\",\n    choices: [\"3/8\\\"\", \"1/2\\\"\", \"5/8\\\"\", \"3/4\\\"\"],\n    correctAnswer: \"3/8\\\"\"\n  },\n  {\n    id: 51,\n    question: \"A depression in the water table with the shape of an inverted cone and develops around a well from which water is being withdrawn.\",\n    choices: [\"Cone of Depression\", \"Drawdown\", \"Hydraulic Gradient\", \"Well Yield\"],\n    correctAnswer: \"Cone of Depression\"\n  },\n  {\n    id: 52,\n    question: \"Who shall set the criteria for the quality of drinking water from meteoric, surface or underground sources?\",\n    choices: [\n      \"Sanitation Code of the Philippines\",\n      \"Water Code of the Philippines\",\n      \"Department of Environment and Natural Resources\",\n      \"National Standards for Drinking Water\"\n    ],\n    correctAnswer: \"National Standards for Drinking Water\"\n  },\n  {\n    id: 53,\n    question: \"A standpipe system that provides 2-1/2\342\200\235 hose connections to supply water for use by fire department.\",\n    choices: [\"Class I System\", \"Class II System\", \"Class III System\", \"Class IIIA System\"],\n    correctAnswer: \"Class I System\"\n  },\n  {\n    id: 54,\n    question: \"Identify the fire sprinkler: Pendent Sprinkler\",\n    choices: [\"A\", \"B\", \"C\", \"D\", \"E\"],\n    correctAnswer: \"B\",\n    image: \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed(4).jpg\"\n  },\n  {\n    id: 55,\n    question: \"Identify the fire sprinkler: Conventional Sprinkler\",\n    choices: [\"A\", \"B\", \"C\", \"D\", \"E\"],\n    correctAnswer: \"C\",\n    image: \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed(4).jpg\"\n  },\n  {\n    id: 56,\n    question: \"Identify the fire sprinkler: Upright Sprinkler\",\n    choices: [\"A\", \"B\", \"C\", \"D\", \"E\"],\n    correctAnswer: \"A\",\n    image: \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed(4).jpg\"\n  },\n  {\n    id: 57,\n    question: \"SI unit of temperature.\",\n    choices: [\"Rankine\", \"Celcius\", \"Kelvin\", \"Farenheit\"],\n    correctAnswer: \"Kelvin\"\n  },\n  {\n    id: 58,\n    question: \"The Provincial Water Utilities Act of 1973.\",\n    choices: [\"PD No. 223\", \"PD No. 1152\", \"PD No. 198\", \"PD No. 856\"],\n    correctAnswer: \"PD No. 198\"\n  },\n  {\n    id: 59,\n    question: \"Identify the part of the valve:\",\n    choices: [\"Packing Gland\", \"Packing Nut\", \"Packing\", \"O-ring\"],\n    correctAnswer: \"Packing\",\n    image: \"./Master\'s Mastery Test_ SPDI Set A_files/unnamed(5).jpg\"\n  },\n  {\n    id: 60,\n    question: \"It is a long metal rod, made of magnesium or aluminum that hangs down from the top of a storage water heater.\",\n    choices: [\"Sacrificial Rod\", \"Cathode Rod\", \"Dip Tube\", \"Refill Tube\"],\n    correctAnswer: \"Sacrificial Rod\"\n  },\n  {\n    id: 61,\n    question: \"When a backflow prevention device does not bear a critical level marking, the part of the device that shall constitute the critical level is the __________.\",\n    choices: [\n      \"flood level\",\n      \"top of the vacuum breaker\",\n      \"center of the vacuum breaker\",\n      \"bottom of the vacuum breaker\"\n    ],\n    correctAnswer: \"bottom of the vacuum breaker\"\n  },\n  {\n    id: 62,\n    question: \"1 hp is equivalent to:\",\n    choices: [\"746 watts\", \"2455 BTU/hr\", \"3,300 ft.lb./min\", \"4.186 J/g\302\260C\"],\n    correctAnswer: \"746 watts\"\n  },\n  {\n    id: 63,\n    question: \"The percentage of oxygen in the Earth\'s atmosphere.\",\n    choices: [\"21%\", \"78%\", \"72%\", \"28%\"],\n    correctAnswer: \"21%\"\n  },\n  {\n    id: 64,\n    question: \"According to the Green Building Code, what is the required fire reserve percentage over and above the average daily demand supply for overhead or elevated water storage systems?\",\n    choices: [\"15%\", \"20%\", \"25%\", \"35%\"],\n    correctAnswer: \"20%\"\n  },\n  {\n    id: 65,\n    question: \"An external thread.\",\n    choices: [\"Durham Thread\", \"Male Thread\", \"Female Thread\", \"Tapered Thread\"],\n    correctAnswer: \"Male Thread\"\n  },\n  {\n    id: 66,\n    question: \"Also called as sitz bath.\",\n    choices: [\"Bidet\", \"Deep Tub\", \"Bathtub\", \"Water Closet\"],\n    correctAnswer: \"Bidet\"\n  },\n  {\n    id: 67,\n    question: \"Also known as Orangeburg pipe.\",\n    choices: [\"Bituminous Fiber Pipe\", \"Terracotta Pipe\", \"Vitrified Clay Pipe\", \"Brass Pipe\"],\n    correctAnswer: \"Bituminous Fiber Pipe\"\n  },\n  {\n    id: 68,\n    question: \"A hot water distribution system commonly used in small residential houses and other industrial installations. In such system, the larger pipe is installed at the bottom of the riser and the diminishing sizes passes through the upper floors of the building.\",\n    choices: [\n      \"Pump Circuit System\",\n      \"Up-Feed and Gravity Return System\",\n      \"Downfeed System\",\n      \"Overhead Feed and Gravity Return System\"\n    ],\n    correctAnswer: \"Up-Feed and Gravity Return System\"\n  },\n  {\n    id: 69,\n    question: \"Barometric loop is installed in water supply systems to protect against back siphonage. It is fabricated piping arrangement rising at least __________ at its topmost point above the highest fixture it supplies.\",\n    choices: [\"30 feet\", \"32 feet\", \"35 feet\", \"40 feet\"],\n    correctAnswer: \"35 feet\"\n  },\n  {\n    id: 70,\n    question: \"Water service level characterized by a system composed of a source, a reservoir, a piped distribution network, and communal faucets. One faucet serves an average of five households within a 25 m-radius.\",\n    choices: [\"Level 1\", \"Level 2\", \"Level 3\", \"Point Source\"],\n    correctAnswer: \"Level 2\"\n  },\n  {\n    id: 71,\n    question: \"What is the minimum size of vent for a water closet?\",\n    choices: [\"32 mm\", \"51 mm\", \"76 mm\", \"102 mm\"],\n    correctAnswer: \"51 mm\"\n  },\n  {\n    id: 72,\n    question: \"A process in which heat is transferred from one region to another by the motion of a fluid.\",\n    choices: [\"Convection\", \"Radiation\", \"Conduction\", \"Induction\"],\n    correctAnswer: \"Convection\"\n  },\n  {\n    id: 73,\n    question: \"It is the extension of a soil or waste stack above the highest horizontal drain connected to the stack.\",\n    choices: [\"Stack Vent\", \"Vent Stack\", \"VSTR\", \"Soil Vent\"],\n    correctAnswer: \"Stack Vent\"\n  },\n  {\n    id: 74,\n    question: \"What is the colorless gas produced inside a septic tank that is characterized by its offensive odor?\",\n    choices: [\"Carbon Dioxide\", \"Hydrogen Sulfide\", \"Methane Gas\", \"Sulfur Dioxide\"],\n    correctAnswer: \"Hydrogen Sulfide\"\n  },\n  {\n    id: 75,\n    question: \"Minimum dimensions of an accessible water closet stall.\",\n    choices: [\"1.7 m x 1.8 m\", \"1.5 m x 1.8 m\", \"0.9 m x 1.2 m\", \"1.5 m x 1.7 m\"],\n    correctAnswer: \"1.5 m x 1.7 m\"\n  },\n  {\n    id: 76,\n    question: \"What is the name of NH\342\202\204H\342\202\202PO\342\202\204, which is the chemical content for a dry chemical fire extinguisher?\",\n    choices: [\"Sodium Potassium Bicarbonate\", \"Monoammonium Phosphate\", \"Bromochlorodifluoromethane\", \"Diammonium Phosphate\"],\n    correctAnswer: \"Monoammonium Phosphate\"\n  }\n];\n"
