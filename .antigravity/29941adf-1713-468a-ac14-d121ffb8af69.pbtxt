        replacement_content: "  {\n    id: 76,\n    question: \"What is the name of NH\342\202\204H\342\202\202PO\342\202\204, which is the chemical content for a dry chemical fire extinguisher?\",\n    choices: [\"Sodium Potassium Bicarbonate\", \"Monoammonium Phosphate\", \"Bromochlorodifluoromethane\", \"Diammonium Phosphate\"],\n    correctAnswer: \"Monoammonium Phosphate\"\n  },\n  {\n    id: 77,\n    question: \"Identify the part of the fire sprinkler bulb indicated by the arrow:\",\n    choices: [\"Vapor Bubble\", \"Glass Shell\", \"Temperature-sensitive Liquid\", \"Cap\"],\n    correctAnswer: \"Vapor Bubble\",\n    questionSvg: `<svg width=\"150\" height=\"200\" viewBox=\"0 0 150 200\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" class=\"text-slate-700 dark:text-slate-300 mx-auto\">\n      <!-- Sprinkler Glass Bulb outline -->\n      <path d=\"M50 20 C40 40, 40 140, 50 160 C55 170, 95 170, 100 160 C110 140, 110 40, 100 20 C95 10, 55 10, 50 20 Z\" fill=\"none\" stroke=\"currentColor\" />\n      <!-- Liquid fill -->\n      <path d=\"M52 25 C45 40, 45 140, 52 155 C56 162, 94 162, 98 155 C105 140, 105 40, 98 25 C94 18, 56 18, 52 25 Z\" fill=\"currentColor\" opacity=\"0.45\" class=\"text-red-500\" />\n      <!-- Vapor/Air Bubble -->\n      <ellipse cx=\"75\" cy=\"50\" rx=\"14\" ry=\"10\" fill=\"white\" stroke=\"currentColor\" stroke-width=\"2\" class=\"text-slate-800\" />\n      <!-- Indication Arrow pointing to the Vapor Bubble -->\n      <g class=\"text-[#ef4444] stroke-current font-bold\" stroke-width=\"2.5\">\n        <path d=\"M135 50 H100\" stroke=\"currentColor\" />\n        <path d=\"M107 43 L100 50 L107 57\" fill=\"none\" stroke=\"currentColor\" />\n        <text x=\"140\" y=\"55\" font-size=\"16\" font-family=\"sans-serif\" font-weight=\"900\" stroke=\"none\" fill=\"currentColor\">?</text>\n      </g>\n    </svg>`\n  },\n  {\n    id: 78,\n    question: \"What is the maximum distance between a cleanout and the point of disposal (e.g., public sewer or septic tank)?\",\n    choices: [\"15 meters\", \"20 meters\", \"30 meters\", \"45 meters\"],\n    correctAnswer: \"15 meters\"\n  },\n  {\n    id: 79,\n    question: \"A water supply pipe that connects a plumbing fixture to a water distribution pipe.\",\n    choices: [\"Fixture Branch\", \"Fixture Supply\", \"Riser\", \"Water Service Pipe\"],\n    correctAnswer: \"Fixture Supply\"\n  },\n  {\n    id: 80,\n    question: \"The maximum spacing between horizontal supports for copper tubing (1-1/2 inches and larger).\",\n    choices: [\"1.5 m\", \"2.0 m\", \"3.0 m\", \"3.6 m\"],\n    correctAnswer: \"3.0 m\"\n  },\n  {\n    id: 81,\n    question: \"A backflow prevention assembly consisting of two independently acting, internally loaded check valves and an automatically operating differential relief valve.\",\n    choices: [\"Atmospheric Vacuum Breaker\", \"Double Check Valve Assembly\", \"Reduced Pressure Principle Backflow Preventer\", \"Pressure Vacuum Breaker\"],\n    correctAnswer: \"Reduced Pressure Principle Backflow Preventer\"\n  },\n  {\n    id: 82,\n    question: \"What is the maximum height of a water closet for disabled access (accessible toilet) measured from the floor to the top of the seat?\",\n    choices: [\"400 mm\", \"450 mm\", \"480 mm\", \"500 mm\"],\n    correctAnswer: \"480 mm\"\n  },\n  {\n    id: 83,\n    question: \"Which trap is commonly used for a lavatory?\",\n    choices: [\"P-trap\", \"S-trap\", \"Drum Trap\", \"Running Trap\"],\n    correctAnswer: \"P-trap\"\n  },\n  {\n    id: 84,\n    question: \"The pipe from the water main or other source of water supply to the building served.\",\n    choices: [\"Water Service Pipe\", \"Water Distribution Pipe\", \"Building Main\", \"Riser\"],\n    correctAnswer: \"Water Service Pipe\"\n  },\n  {\n    id: 85,\n    question: \"What is the standard vertical distance required between a water line and a sewer line when laid in the same trench?\",\n    choices: [\"0.15 m\", \"0.30 m\", \"0.45 m\", \"0.60 m\"],\n    correctAnswer: \"0.30 m\"\n  },\n  {\n    id: 86,\n    question: \"A type of vent that is used to vent a single fixture trap and is connected to the vent system.\",\n    choices: [\"Individual Vent\", \"Common Vent\", \"Loop Vent\", \"Circuit Vent\"],\n    correctAnswer: \"Individual Vent\"\n  },\n  {\n    id: 87,\n    question: \"A pit or receptacle at a low point to which liquid waste, especially sewage or bilge water, drains and from which it is pumped.\",\n    choices: [\"Sump\", \"Cesspool\", \"Privy\", \"Manhole\"],\n    correctAnswer: \"Sump\"\n  },\n  {\n    id: 88,\n    question: \"The water closet bowl shape required for public use is:\",\n    choices: [\"Round Front\", \"Elongated Type\", \"Square Front\", \"Compact Type\"],\n    correctAnswer: \"Elongated Type\"\n  },\n  {\n    id: 89,\n    question: \"The vertical distance between the dip and the crown weir of a trap.\",\n    choices: [\"Trap Seal\", \"Trap Depth\", \"Water Seal\", \"Trap Height\"],\n    correctAnswer: \"Trap Seal\"\n  },\n  {\n    id: 90,\n    question: \"What is the maximum fixture unit value that can be discharged into a 2-inch horizontal waste line?\",\n    choices: [\"4 WSFU\", \"8 WSFU\", \"16 WSFU\", \"24 WSFU\"],\n    correctAnswer: \"8 WSFU\"\n  },\n  {\n    id: 91,\n    question: \"What type of joint is typically used to connect cast iron pipes without hubs (no-hub)?\",\n    choices: [\"Shielded Coupling Joint\", \"Threaded Joint\", \"Wiped Joint\", \"Lead and Oakum Joint\"],\n    correctAnswer: \"Shielded Coupling Joint\"\n  },\n  {\n    id: 92,\n    question: \"A device installed in a drainage system to prevent siphonage or backpressure of trap seals.\",\n    choices: [\"Vent Pipe\", \"Air Gap\", \"Cleanout\", \"Interceptor\"],\n    correctAnswer: \"Vent Pipe\"\n  },\n  {\n    id: 93,\n    question: \"What is the minimum diameter of a building sewer?\",\n    choices: [\"50 mm\", \"75 mm\", \"100 mm\", \"150 mm\"],\n    correctAnswer: \"150 mm\"\n  },\n  {\n    id: 94,\n    question: \"The pressure of water standing in a pipe when no water is flowing.\",\n    choices: [\"Static Pressure\", \"Residual Pressure\", \"Working Pressure\", \"Flow Pressure\"],\n    correctAnswer: \"Static Pressure\"\n  },\n  {\n    id: 95,\n    question: \"An emergency safety device used to shut off water or gas supply to a building.\",\n    choices: [\"Main Control Valve\", \"Corporation Stop\", \"Curb Stop\", \"Gate Valve\"],\n    correctAnswer: \"Curb Stop\"\n  },\n  {\n    id: 96,\n    question: \"Which plumbing fixture is designed to prevent the backflow of foul gases from the drainage system?\",\n    choices: [\"Trap\", \"Vent\", \"Cleanout\", \"Baffle\"],\n    correctAnswer: \"Trap\"\n  },\n  {\n    id: 97,\n    question: \"The slope or fall of horizontal drainage pipes must not be less than __________ per foot or 2%.\",\n    choices: [\"1/16 inch\", \"1/8 inch\", \"1/4 inch\", \"1/2 inch\"],\n    correctAnswer: \"1/4 inch\"\n  },\n  {\n    id: 98,\n    question: \"What is the chemical used to test the residual level of chlorine in water during water disinfection?\",\n    choices: [\"Orthotolidine\", \"Sodium Thiosulfate\", \"Calcium Hypochlorite\", \"Copper Sulfate\"],\n    correctAnswer: \"Orthotolidine\"\n  },\n  {\n    id: 99,\n    question: \"A piping arrangement where a single vent pipe serves two fixtures installed back-to-back or side-by-back.\",\n    choices: [\"Common Vent\", \"Yoke Vent\", \"Wet Vent\", \"Loop Vent\"],\n    correctAnswer: \"Common Vent\"\n  },\n  {\n    id: 100,\n    question: \"What is the chemical or physical treatment system that uses a semi-permeable membrane to remove dissolved solids, organics, and pyrogens?\",\n    choices: [\"Reverse Osmosis System\", \"Water Softener\", \"Sand Filter\", \"Activated Carbon Filter\"],\n    correctAnswer: \"Reverse Osmosis System\"\n  }\n];"
      }
