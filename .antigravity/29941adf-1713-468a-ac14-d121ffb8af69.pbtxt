        }
        lines {
          text: "      // Normalize currentIdx"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (currentIdx >= originalIndicesMap.length) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
