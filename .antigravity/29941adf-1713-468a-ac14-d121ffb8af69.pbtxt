    instruction: "Add elegant image loading fallback message for local reviewer images"
    replacement_infos {
      original_chunk {
        target_content: "      // Question Media (Attachment)\n      const mediaBox = document.getElementById(\'question-media-container\');\n      const img = document.getElementById(\'question-image\');\n      let svgDiv = document.getElementById(\'question-svg\');\n      if (!svgDiv) {\n        svgDiv = document.createElement(\'div\');\n        svgDiv.id = \'question-svg\';\n        svgDiv.className = \'w-full flex justify-center hidden\';\n        mediaBox.appendChild(svgDiv);\n      }\n      \n      if (q.questionSvg) {\n        svgDiv.innerHTML = q.questionSvg;\n        svgDiv.classList.remove(\'hidden\');\n        img.classList.add(\'hidden\');\n        mediaBox.classList.remove(\'hidden\');\n      } else if (q.image) {\n        img.src = q.image;\n        img.classList.remove(\'hidden\');\n        svgDiv.classList.add(\'hidden\');\n        mediaBox.classList.remove(\'hidden\');\n      } else {\n        mediaBox.classList.add(\'hidden\');\n      }"
        replacement_content: "      // Question Media (Attachment)\n      const mediaBox = document.getElementById(\'question-media-container\');\n      const img = document.getElementById(\'question-image\');\n      let svgDiv = document.getElementById(\'question-svg\');\n      if (!svgDiv) {\n        svgDiv = document.createElement(\'div\');\n        svgDiv.id = \'question-svg\';\n        svgDiv.className = \'w-full flex justify-center hidden\';\n        mediaBox.appendChild(svgDiv);\n      }\n      \n      let fallbackDiv = document.getElementById(\'media-fallback\');\n      if (!fallbackDiv) {\n        fallbackDiv = document.createElement(\'div\');\n        fallbackDiv.id = \'media-fallback\';\n        mediaBox.appendChild(fallbackDiv);\n      }\n      fallbackDiv.classList.add(\'hidden\');\n      \n      if (q.questionSvg) {\n        svgDiv.innerHTML = q.questionSvg;\n        svgDiv.classList.remove(\'hidden\');\n        img.classList.add(\'hidden\');\n        fallbackDiv.classList.add(\'hidden\');\n        mediaBox.classList.remove(\'hidden\');\n      } else if (q.image) {\n        img.src = q.image;\n        img.classList.remove(\'hidden\');\n        svgDiv.classList.add(\'hidden\');\n        mediaBox.classList.remove(\'hidden\');\n        \n        img.onerror = () => {\n          img.classList.add(\'hidden\');\n          fallbackDiv.className = \"flex flex-col items-center justify-center p-6 text-center border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-xl bg-slate-50 dark:bg-slate-900/50 max-w-md mx-auto w-full\";\n          fallbackDiv.innerHTML = `\n            <div class=\"w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 mb-3\">\n              <i data-lucide=\"image\" class=\"w-6 h-6\"></i>\n            </div>\n            <h4 class=\"font-bold text-slate-800 dark:text-slate-200 text-sm mb-1\">Local Image Asset</h4>\n            <p class=\"text-xs text-slate-500 dark:text-slate-400 mb-3 font-mono break-all\">${q.image}</p>\n            <p class=\"text-[11px] text-slate-400 dark:text-slate-500 leading-normal\">This image will load automatically when you run the exported code locally alongside your <strong>Master\'s Mastery Test_ SPDI Set A_files</strong> folder.</p>\n          `;\n          fallbackDiv.classList.remove(\'hidden\');\n          if (window.lucide) {\n            window.lucide.createIcons();\n          }\n        };\n        img.onload = () => {\n          fallbackDiv.classList.add(\'hidden\');\n        };\n      } else {\n        mediaBox.classList.add(\'hidden\');\n        fallbackDiv.classList.add(\'hidden\');\n      }"
      }
      num_matches: 1
    }
  }
}
