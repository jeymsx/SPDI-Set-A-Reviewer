    replacement_infos {
      original_chunk {
        target_content: "      // Question Media (Attachment)\n      const mediaBox = document.getElementById(\'question-media-container\');\n      const img = document.getElementById(\'question-image\');\n      if (q.image) {\n        img.src = q.image;\n        mediaBox.classList.remove(\'hidden\');\n      } else {\n        mediaBox.classList.add(\'hidden\');\n      }"
        replacement_content: "      // Question Media (Attachment)\n      const mediaBox = document.getElementById(\'question-media-container\');\n      const img = document.getElementById(\'question-image\');\n      let svgDiv = document.getElementById(\'question-svg\');\n      if (!svgDiv) {\n        svgDiv = document.createElement(\'div\');\n        svgDiv.id = \'question-svg\';\n        svgDiv.className = \'w-full flex justify-center hidden\';\n        mediaBox.appendChild(svgDiv);\n      }\n      \n      if (q.questionSvg) {\n        svgDiv.innerHTML = q.questionSvg;\n        svgDiv.classList.remove(\'hidden\');\n        img.classList.add(\'hidden\');\n        mediaBox.classList.remove(\'hidden\');\n      } else if (q.image) {\n        img.src = q.image;\n        img.classList.remove(\'hidden\');\n        svgDiv.classList.add(\'hidden\');\n        mediaBox.classList.remove(\'hidden\');\n      } else {\n        mediaBox.classList.add(\'hidden\');\n      }"
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "      choicesOrder.forEach((idx, listPosition) => {\n        const choice = q.choices[idx];\n        const isSelected = userAnswers[q.id] === choice;\n\n        const choiceBtn = document.createElement(\'button\');\n        choiceBtn.type = \"button\";\n        choiceBtn.className = \"w-full text-left p-4 rounded-xl border-2 flex items-center justify-between transition-all duration-200 font-semibold text-sm group cursor-pointer \";\n\n        // Option prefix letter badge\n        const prefix = String.fromCharCode(65 + listPosition); // A, B, C, D...\n\n        // Left wrapper\n        const leftWrap = document.createElement(\'div\');\n        leftWrap.className = \"flex items-center space-x-3.5\";\n\n        const letterBadge = document.createElement(\'span\');\n        letterBadge.className = \"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all duration-200 shrink-0 \";\n        letterBadge.innerText = prefix;\n\n        const textSpan = document.createElement(\'span\');\n        textSpan.innerText = choice;\n        textSpan.className = \"text-[#1e293b] dark:text-[#f1f5f9]\";\n\n        leftWrap.appendChild(letterBadge);\n        leftWrap.appendChild(textSpan);\n        choiceBtn.appendChild(leftWrap);"
        replacement_content: "      choicesOrder.forEach((idx, listPosition) => {\n        const choice = q.choices[idx];\n        const isSelected = userAnswers[q.id] === choice;\n\n        const choiceBtn = document.createElement(\'button\');\n        choiceBtn.type = \"button\";\n\n        // Option prefix letter badge\n        const prefix = String.fromCharCode(65 + listPosition); // A, B, C, D...\n\n        const letterBadge = document.createElement(\'span\');\n        letterBadge.className = \"w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all duration-200 shrink-0 \";\n        letterBadge.innerText = prefix;\n\n        const textSpan = document.createElement(\'span\');\n        textSpan.innerText = choice;\n        textSpan.className = \"text-[#1e293b] dark:text-[#f1f5f9]\";\n\n        if (q.svgs && q.svgs[idx]) {\n          choiceBtn.className = \"w-full text-left p-4 rounded-xl border-2 flex flex-col items-start space-y-3 transition-all duration-200 font-semibold text-sm group cursor-pointer \";\n          \n          const headerWrap = document.createElement(\'div\');\n          headerWrap.className = \"flex items-center space-x-3.5 w-full\";\n          headerWrap.appendChild(letterBadge);\n          headerWrap.appendChild(textSpan);\n          choiceBtn.appendChild(headerWrap);\n          \n          const svgWrap = document.createElement(\'div\');\n          svgWrap.className = \"w-full flex justify-center py-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-100 dark:border-slate-800/80\";\n          svgWrap.innerHTML = q.svgs[idx];\n          choiceBtn.appendChild(svgWrap);\n        } else {\n          choiceBtn.className = \"w-full text-left p-4 rounded-xl border-2 flex items-center justify-between transition-all duration-200 font-semibold text-sm group cursor-pointer \";\n          \n          const leftWrap = document.createElement(\'div\');\n          leftWrap.className = \"flex items-center space-x-3.5\";\n          leftWrap.appendChild(letterBadge);\n          leftWrap.appendChild(textSpan);\n          choiceBtn.appendChild(leftWrap);\n        }"
      }
