    instruction: "Style body, top decoration, header, and shortcuts helper in index.html to match the Professional Polish theme."
    replacement_infos {
      original_chunk {
        target_content: "<body class=\"bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-100 min-h-screen transition-colors duration-200\">\n\n  <!-- TOP DECORATION BAR -->\n  <div class=\"h-1.5 w-full bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500\"></div>\n\n  <!-- HEADER -->\n  <header class=\"border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-40\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between\">\n      <div class=\"flex items-center space-x-3\">\n        <div class=\"p-2 bg-indigo-50 dark:bg-indigo-950/50 rounded-xl text-indigo-600 dark:text-indigo-400\">\n          <i data-lucide=\"award\" class=\"w-6 h-6\"></i>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold tracking-tight text-slate-900 dark:text-white\">Master\'s Mastery</h1>\n          <p class=\"text-xs text-slate-500 dark:text-slate-400 font-medium\">SPDI Set A Reviewer</p>\n        </div>\n      </div>\n      \n      <!-- HEADER CONTROLS -->\n      <div class=\"flex items-center space-x-3\">\n        <!-- THEME TOGGLE -->\n        <button id=\"theme-toggle\" class=\"p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800 transition-colors\" title=\"Toggle theme\">\n          <i data-lucide=\"sun\" class=\"w-5 h-5 hidden dark:block\"></i>\n          <i data-lucide=\"moon\" class=\"w-5 h-5 block dark:hidden\"></i>\n        </button>\n\n        <!-- HELP / INFO TRIGGER -->\n        <button id=\"help-toggle\" class=\"p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800 transition-colors\" title=\"Keyboard Shortcuts\">\n          <i data-lucide=\"keyboard\" class=\"w-5 h-5\"></i>\n        </button>\n\n        <!-- RESET STATE -->\n        <button id=\"reset-test-btn\" class=\"p-2 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/20 transition-colors\" title=\"Reset all answers\">\n          <i data-lucide=\"rotate-ccw\" class=\"w-5 h-5\"></i>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- KEYBOARD SHORTCUTS MODAL FALLBACK (INLINE DISMISSIBLE ALERT) -->\n  <div id=\"shortcuts-helper\" class=\"hidden bg-indigo-50 dark:bg-indigo-950/40 border-b border-indigo-100 dark:border-indigo-900/50 transition-all duration-200\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between text-xs text-indigo-800 dark:text-indigo-300\">\n      <div class=\"flex flex-wrap items-center gap-4\">\n        <span class=\"font-semibold\"><i data-lucide=\"zap\" class=\"w-4 h-4 inline mr-1\"></i> Quick Shortcuts:</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">\342\206\220</kbd> Previous</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">\342\206\222</kbd> Next</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">1</kbd> - <kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border rounded shadow-sm\">4</kbd> Select Answer</span>\n      </div>\n      <button onclick=\"toggleShortcutsHelper()\" class=\"text-indigo-500 hover:text-indigo-700 dark:hover:text-indigo-100 p-1\">\n        <i data-lucide=\"x\" class=\"w-4 h-4\"></i>\n      </button>\n    </div>\n  </div>"
        replacement_content: "<body class=\"bg-[#f8fafc] text-[#1e293b] dark:bg-[#0f172a] dark:text-[#f1f5f9] min-h-screen transition-colors duration-200\">\n\n  <!-- TOP DECORATION BAR -->\n  <div class=\"h-1 w-full bg-[#2563eb]\"></div>\n\n  <!-- HEADER -->\n  <header class=\"border-b border-[#e2e8f0] dark:border-[#334155] bg-white/90 dark:bg-[#1e293b]/90 backdrop-blur sticky top-0 z-40\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between\">\n      <div class=\"flex items-center space-x-3\">\n        <div class=\"w-10 h-10 bg-[#2563eb] rounded-lg flex items-center justify-center text-white font-bold\">\n          <i data-lucide=\"award\" class=\"w-5 h-5\"></i>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold tracking-tight text-[#1e293b] dark:text-white\">Master\'s Mastery</h1>\n          <p class=\"text-xs text-[#64748b] dark:text-[#94a3b8] font-semibold\">SPDI Set A Reviewer</p>\n        </div>\n      </div>\n      \n      <!-- HEADER CONTROLS -->\n      <div class=\"flex items-center space-x-3\">\n        <!-- THEME TOGGLE -->\n        <button id=\"theme-toggle\" class=\"p-2 rounded-lg text-[#64748b] hover:bg-slate-100 dark:text-[#94a3b8] dark:hover:bg-slate-800 transition-colors\" title=\"Toggle theme\">\n          <i data-lucide=\"sun\" class=\"w-5 h-5 hidden dark:block\"></i>\n          <i data-lucide=\"moon\" class=\"w-5 h-5 block dark:hidden\"></i>\n        </button>\n\n        <!-- HELP / INFO TRIGGER -->\n        <button id=\"help-toggle\" class=\"p-2 rounded-lg text-[#64748b] hover:bg-slate-100 dark:text-[#94a3b8] dark:hover:bg-slate-800 transition-colors\" title=\"Keyboard Shortcuts\">\n          <i data-lucide=\"keyboard\" class=\"w-5 h-5\"></i>\n        </button>\n\n        <!-- RESET STATE -->\n        <button id=\"reset-test-btn\" class=\"p-2 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/20 transition-colors\" title=\"Reset all answers\">\n          <i data-lucide=\"rotate-ccw\" class=\"w-5 h-5\"></i>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- KEYBOARD SHORTCUTS MODAL FALLBACK (INLINE DISMISSIBLE ALERT) -->\n  <div id=\"shortcuts-helper\" class=\"hidden bg-[#eff6ff] dark:bg-[#1e293b]/40 border-b border-[#e2e8f0] dark:border-[#334155] transition-all duration-200\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between text-xs text-[#2563eb] dark:text-[#60a5fa]\">\n      <div class=\"flex flex-wrap items-center gap-4\">\n        <span class=\"font-bold\"><i data-lucide=\"zap\" class=\"w-4 h-4 inline mr-1 text-[#2563eb]\"></i> Quick Shortcuts:</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border border-[#e2e8f0] dark:border-[#334155] rounded shadow-sm\">\342\206\220</kbd> Previous</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border border-[#e2e8f0] dark:border-[#334155] rounded shadow-sm\">\342\206\222</kbd> Next</span>\n        <span><kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border border-[#e2e8f0] dark:border-[#334155] rounded shadow-sm\">1</kbd> - <kbd class=\"px-1.5 py-0.5 bg-white dark:bg-slate-800 border border-[#e2e8f0] dark:border-[#334155] rounded shadow-sm\">4</kbd> Select Answer</span>\n      </div>\n      <button onclick=\"toggleShortcutsHelper()\" class=\"text-[#2563eb] hover:text-[#1d4ed8] dark:hover:text-[#f1f5f9] p-1\">\n        <i data-lucide=\"x\" class=\"w-4 h-4\"></i>\n      </button>\n    </div>\n  </div>"
