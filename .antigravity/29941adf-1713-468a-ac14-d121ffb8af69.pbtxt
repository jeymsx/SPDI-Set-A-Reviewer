        }
        lines {
          text: "      if (savedDuration !== null) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        timerDuration = parseInt(savedDuration);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        document.getElementById(\'start-duration-select\').value = timerDuration.toString();"
