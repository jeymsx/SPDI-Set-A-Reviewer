    instruction: "Apply Professional Polish theme to the finalize block, exam settings controls, search bar, and navigator grid container in index.html."
    replacement_infos {
      original_chunk {
        target_content: "        <!-- FORM FINALIZE BLOCK (Submit test) -->\n        <div id=\"submit-section\" class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div class=\"space-y-1 text-center sm:text-left\">\n            <h4 class=\"font-bold text-sm text-slate-900 dark:text-white\">Ready to finalize?</h4>\n            <p class=\"text-xs text-slate-500 dark:text-slate-400\">Ensure you\'ve answered as much as possible before submitting your score.</p>\n          </div>\n          <button id=\"submit-test-btn\" class=\"w-full sm:w-auto px-8 py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/20 hover:shadow-indigo-500/30 transition-all\">\n            Submit Exam\n          </button>\n        </div>\n\n      </div>\n\n      <!-- SIDEBAR SETTINGS & QUESTION NAVIGATOR (4 COLS) -->\n      <div class=\"lg:col-span-4 space-y-6\">\n        \n        <!-- EXAM CONTROLS CARD -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm space-y-5\">\n          <h3 class=\"font-bold text-slate-900 dark:text-white flex items-center space-x-2\">\n            <i data-lucide=\"settings\" class=\"w-4 h-4 text-indigo-500\"></i>\n            <span>Exam Settings</span>\n          </h3>\n\n          <div class=\"space-y-4 text-sm font-semibold\">\n            <!-- Shuffle Questions -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-slate-600 dark:text-slate-300 group-hover:text-slate-950 dark:group-hover:text-white transition-colors\">Shuffle Questions</span>\n              <input type=\"checkbox\" id=\"shuffle-questions-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative\"></div>\n            </label>\n\n            <!-- Shuffle Choices -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-slate-600 dark:text-slate-300 group-hover:text-slate-950 dark:group-hover:text-white transition-colors\">Shuffle Choices</span>\n              <input type=\"checkbox\" id=\"shuffle-choices-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative\"></div>\n            </label>\n\n            <!-- Targeted Study: Review Incorrect -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-slate-600 dark:text-slate-300 group-hover:text-slate-950 dark:group-hover:text-white transition-colors\">Review Incorrect Only</span>\n              <input type=\"checkbox\" id=\"review-incorrect-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600 relative\"></div>\n            </label>\n          </div>\n        </div>\n\n        <!-- SEARCH BAR -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-100 dark:border-slate-800 shadow-sm relative\">\n          <input type=\"text\" id=\"search-input\" placeholder=\"Search questions...\" class=\"w-full text-sm pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg focus:outline-none focus:border-indigo-500 transition-colors dark:text-white\">\n          <div class=\"absolute left-7 top-5 text-slate-400 dark:text-slate-500\">\n            <i data-lucide=\"search\" class=\"w-4 h-4\"></i>\n          </div>\n        </div>\n\n        <!-- QUESTION NAVIGATOR GRID -->\n        <div class=\"bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm space-y-4\">\n          <div class=\"flex items-center justify-between\">\n            <h3 class=\"font-bold text-slate-900 dark:text-white flex items-center space-x-2\">\n              <i data-lucide=\"grid\" class=\"w-4 h-4 text-indigo-500\"></i>\n              <span>Navigator</span>\n            </h3>\n            <span id=\"nav-count\" class=\"text-xs font-semibold bg-slate-100 dark:bg-slate-900 px-2 py-1 rounded-md text-slate-500 dark:text-slate-400\">\n              0 / 76\n            </span>\n          </div>\n\n          <!-- Color Legends -->\n          <div class=\"flex flex-wrap gap-2 text-[10px] font-semibold text-slate-500\">\n            <div class=\"flex items-center space-x-1\">\n              <span class=\"w-2.5 h-2.5 rounded bg-slate-200 dark:bg-slate-700\"></span>\n              <span>Unanswered</span>\n            </div>\n            <div class=\"flex items-center space-x-1\">\n              <span class=\"w-2.5 h-2.5 rounded bg-indigo-500\"></span>\n              <span>Answered</span>\n            </div>\n            <div class=\"flex items-center space-x-1 post-submit-only hidden\">\n              <span class=\"w-2.5 h-2.5 rounded bg-emerald-500\"></span>\n              <span>Correct</span>\n            </div>\n            <div class=\"flex items-center space-x-1 post-submit-only hidden\">\n              <span class=\"w-2.5 h-2.5 rounded bg-rose-500\"></span>\n              <span>Incorrect</span>\n            </div>\n          </div>\n\n          <!-- Scrollable Grid Container -->\n          <div class=\"max-h-[340px] overflow-y-auto pr-1\">\n            <div id=\"navigator-grid\" class=\"grid grid-cols-6 sm:grid-cols-8 md:grid-cols-10 lg:grid-cols-6 gap-2\">\n              <!-- Grid items injected dynamically -->\n            </div>\n          </div>\n        </div>\n\n        <!-- RESET CONFIRM DIALOG -->\n        <div id=\"reset-confirm-panel\" class=\"hidden bg-rose-50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/50 rounded-xl p-4 text-center space-y-3\">\n          <p class=\"text-xs font-bold text-rose-800 dark:text-rose-300\">Are you sure? This deletes saved answers, score, and shuffles.</p>\n          <div class=\"flex items-center justify-center space-x-2 text-xs\">\n            <button onclick=\"confirmReset()\" class=\"px-4 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded font-bold\">Yes, Reset</button>\n            <button onclick=\"cancelReset()\" class=\"px-4 py-1.5 bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 text-slate-700 dark:text-slate-300 rounded font-semibold\">Cancel</button>\n          </div>\n        </div>"
        replacement_content: "        <!-- FORM FINALIZE BLOCK (Submit test) -->\n        <div id=\"submit-section\" class=\"bg-white dark:bg-[#1e293b] rounded-xl p-6 border border-[#e2e8f0] dark:border-[#334155] shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div class=\"space-y-1 text-center sm:text-left\">\n            <h4 class=\"font-bold text-sm text-[#1e293b] dark:text-white\">Ready to finalize?</h4>\n            <p class=\"text-xs text-[#64748b] dark:text-[#94a3b8]\">Ensure you\'ve answered as much as possible before submitting your score.</p>\n          </div>\n          <button id=\"submit-test-btn\" class=\"w-full sm:w-auto px-6 py-2.5 bg-[#059669] hover:bg-[#047857] text-white font-bold text-sm rounded-md shadow-md transition-all cursor-pointer\">\n            Submit Exam\n          </button>\n        </div>\n\n      </div>\n\n      <!-- SIDEBAR SETTINGS & QUESTION NAVIGATOR (4 COLS) -->\n      <div class=\"lg:col-span-4 space-y-6\">\n        \n        <!-- EXAM CONTROLS CARD -->\n        <div class=\"bg-white dark:bg-[#1e293b] rounded-xl p-6 border border-[#e2e8f0] dark:border-[#334155] shadow-sm space-y-5\">\n          <h3 class=\"font-bold text-[#1e293b] dark:text-white flex items-center space-x-2\">\n            <i data-lucide=\"settings\" class=\"w-4 h-4 text-[#2563eb] dark:text-[#3b82f6]\"></i>\n            <span>Exam Settings</span>\n          </h3>\n\n          <div class=\"space-y-4 text-sm font-semibold\">\n            <!-- Shuffle Questions -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-[#64748b] dark:text-[#94a3b8] group-hover:text-[#1e293b] dark:group-hover:text-white transition-colors\">Shuffle Questions</span>\n              <input type=\"checkbox\" id=\"shuffle-questions-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-[#e2e8f0] dark:bg-[#334155] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-[#e2e8f0] after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#2563eb] relative\"></div>\n            </label>\n\n            <!-- Shuffle Choices -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-[#64748b] dark:text-[#94a3b8] group-hover:text-[#1e293b] dark:group-hover:text-white transition-colors\">Shuffle Choices</span>\n              <input type=\"checkbox\" id=\"shuffle-choices-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-[#e2e8f0] dark:bg-[#334155] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-[#e2e8f0] after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#2563eb] relative\"></div>\n            </label>\n\n            <!-- Targeted Study: Review Incorrect -->\n            <label class=\"flex items-center justify-between cursor-pointer group\">\n              <span class=\"text-[#64748b] dark:text-[#94a3b8] group-hover:text-[#1e293b] dark:group-hover:text-white transition-colors\">Review Incorrect Only</span>\n              <input type=\"checkbox\" id=\"review-incorrect-toggle\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-[#e2e8f0] dark:bg-[#334155] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-[#e2e8f0] after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#2563eb] relative\"></div>\n            </label>\n          </div>\n        </div>\n\n        <!-- SEARCH BAR -->